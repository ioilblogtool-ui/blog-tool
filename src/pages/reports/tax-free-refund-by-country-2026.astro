---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import CalculatorHero from "../../components/CalculatorHero.astro";
import InfoNotice from "../../components/InfoNotice.astro";
import DesignTrustPanel from "../../components/DesignTrustPanel.astro";
import SeoContent from "../../components/SeoContent.astro";
import {
  TFRR_META,
  TFRR_FAQ,
  TFRR_SEO_INTRO,
  TFRR_CRITERIA,
  TFRR_RELATED_LINKS,
  TFR_COUNTRIES,
  TFR_FX,
  TFR_JAPAN_CHANGE,
  TFR_JAPAN_TIPS,
  TFR_STEPS,
  TFR_REFUND_METHODS,
} from "../../data/taxFreeRefund2026";

const normalizedBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${normalizedBase}${path.replace(/^\//, "")}`;

const krwApprox = (v: number) => {
  if (v >= 10000) return `약 ${Math.round(v / 1000) / 10}만원`;
  return `약 ${(Math.round(v / 100) * 100).toLocaleString("ko-KR")}원`;
};
const localAmount = (v: number, cur: string, label: string) =>
  `${v.toLocaleString("ko-KR", { maximumFractionDigits: ["JPY", "TWD", "THB"].includes(cur) ? 0 : 2 })}${label}`;

const rows = TFR_COUNTRIES.map((c) => {
  const fx = TFR_FX.rates[c.currency];
  const minLocal = c.minPurchase == null ? null : c.minBasis === "pre-tax" ? c.minPurchase * (1 + c.vatRate) : c.minPurchase;
  return {
    c,
    vatText: c.reducedRate ? `${c.vatRate * 100}% (식품 ${c.reducedRate * 100}%)` : `${Math.round(c.vatRate * 100)}%`,
    minText: !c.available
      ? "—"
      : c.minPurchase == null
        ? "없음"
        : `${localAmount(c.minPurchase, c.currency, c.currencyLabel)}${c.minBasis === "pre-tax" ? " (세전)" : ""}`,
    minKrw: minLocal != null && fx ? krwApprox(minLocal * fx) : "",
    maxRateText: c.available ? `${((c.vatRate / (1 + c.vatRate)) * 100).toFixed(2)}%` : "환급 없음",
  };
});

const regionNotes = TFR_COUNTRIES.filter((c) => c.code !== "JP");

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: TFRR_META.title,
      description: TFRR_META.seoDescription,
      inLanguage: "ko-KR",
      dateModified: TFRR_META.updatedAt,
      mainEntityOfPage: `https://bigyocalc.com/reports/${TFRR_META.slug}/`,
    },
    {
      "@type": "FAQPage",
      mainEntity: TFRR_FAQ.map((f) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: { "@type": "Answer", text: f.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title={TFRR_META.seoTitle}
  description={TFRR_META.seoDescription}
  ogImage="/og/reports/tax-free-refund-by-country-2026.png"
  jsonLd={jsonLd}
>
  <SiteHeader />
  <main class="container page-shell report-page op-page tfrr-page">
    <CalculatorHero eyebrow={TFRR_META.eyebrow} title={TFRR_META.h1} description={TFRR_META.description} />

    <InfoNotice
      title="기준 안내"
      lines={[
        `${TFRR_META.updatedAt} 기준 각국 정부·세관 자료와 공항 안내를 바탕으로 정리했습니다. 제도는 바뀔 수 있습니다.`,
        "최대 환급률은 계산식 값이며, 실제로는 환급 대행사 수수료가 빠져 더 적게 받습니다.",
        "'확인 필요' 국가는 출국 전 공식 안내를 다시 확인하세요.",
      ]}
    />
    <DesignTrustPanel
      title="택스프리 비교 기준"
      updatedAt={TFRR_META.updatedAt}
      notes={[
        "최소금액은 같은 매장·같은 날 구매 기준이 일반적이며, 나라별 예외는 표 아래 주의사항에 정리했습니다.",
        `원화 환산은 ${TFR_FX.asOf} 매매기준율 기준 참고값입니다.`,
      ]}
    />

    {/* 1. 일본 변경 */}
    <section class="op-section">
      <div class="section-header section-header--compact">
        <p class="section-header__eyebrow">2026년 11월 변경</p>
        <h2>일본 택스프리, 이제 출국할 때 돌려받습니다</h2>
      </div>
      <div class="tfrr-japan">
        <p class="tfrr-japan__lead">
          2026년 11월 1일 구매분부터 매장에서 소비세를 빼주지 않습니다. 세금 포함 가격으로 결제하고, 출국일 공항·항만에서 세관 확인을 받은 뒤 돌려받습니다.
        </p>
        <div class="op-table-wrap">
          <table class="tfrr-table tfrr-table--japan">
            <thead><tr><th>항목</th><th>2026-10-31까지</th><th>2026-11-01부터</th></tr></thead>
            <tbody>
              {TFR_JAPAN_CHANGE.map((row) => (
                <tr><th scope="row">{row.item}</th><td>{row.before}</td><td><strong>{row.after}</strong></td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <ul class="tfrr-tips">
          {TFR_JAPAN_TIPS.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </section>

    {/* 2. 10개국 비교표 */}
    <section class="op-section">
      <div class="section-header section-header--compact">
        <p class="section-header__eyebrow">10개국 비교</p>
        <h2>나라별 최소금액·부가세·환급 장소</h2>
      </div>
      <p class="tfrr-note">최대 환급률 = 세율 ÷ (1 + 세율). 결제 금액에 세금이 이미 들어 있어 부가세율보다 낮습니다.</p>
      <div class="op-table-wrap">
        <table class="tfrr-table tfrr-table--matrix">
          <thead>
            <tr><th>국가</th><th>부가세</th><th>최소 구매금액</th><th>최대 환급률</th><th>환급 장소</th><th>상태</th></tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr class:list={{ "is-off": !row.c.available }}>
                <th scope="row" data-label="국가">{row.c.flag} {row.c.name}</th>
                <td data-label="부가세">{row.vatText}</td>
                <td data-label="최소 구매금액">
                  {row.minText}
                  {row.minKrw && <span class="tfrr-sub">{row.minKrw}</span>}
                </td>
                <td data-label="최대 환급률">{row.maxRateText}</td>
                <td data-label="환급 장소" class="tfrr-place">{row.c.refundPlace}</td>
                <td data-label="상태">
                  <span class:list={["tfrr-badge", { "tfrr-badge--ok": row.c.status === "verified" }]}>
                    {row.c.status === "verified" ? "공식 확인" : "확인 필요"}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {/* 3. 공통 절차 */}
    <section class="op-section">
      <div class="section-header section-header--compact">
        <p class="section-header__eyebrow">공통 절차</p>
        <h2>택스프리 받는 4단계</h2>
      </div>
      <ol class="tfrr-steps">
        {TFR_STEPS.map((s) => (
          <li><strong>{s.title}</strong><p>{s.body}</p></li>
        ))}
      </ol>
    </section>

    {/* 4. 나라별 주의사항 */}
    <section class="op-section">
      <div class="section-header section-header--compact">
        <p class="section-header__eyebrow">나라별 주의사항</p>
        <h2>놓치기 쉬운 나라별 규칙</h2>
      </div>
      <div class="tfrr-country-grid">
        {regionNotes.map((c) => (
          <article class="tfrr-country-card">
            <p class="tfrr-country-card__title">{c.flag} {c.name} <span class="tfrr-sub">{c.minLabel}</span></p>
            <ul>{c.notes.map((n) => <li>{n}</li>)}</ul>
            {c.sources.length > 0 && (
              <p class="tfrr-sources">
                출처:{" "}
                {c.sources.map((s, i) => (
                  <>
                    {i > 0 && " · "}
                    <a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
                  </>
                ))}
              </p>
            )}
          </article>
        ))}
      </div>
    </section>

    {/* 5. 카드 vs 현금 */}
    <section class="op-section">
      <div class="section-header section-header--compact">
        <p class="section-header__eyebrow">환급 방법</p>
        <h2>카드 환급 vs 현금 환급</h2>
      </div>
      <div class="tfrr-method-grid">
        {TFR_REFUND_METHODS.map((m) => (
          <article class="tfrr-method-card">
            <p class="tfrr-method-card__title">{m.method}</p>
            <p class="tfrr-tag tfrr-tag--pro">장점</p>
            <ul>{m.pros.map((p) => <li>{p}</li>)}</ul>
            <p class="tfrr-tag tfrr-tag--con">주의</p>
            <ul>{m.cons.map((p) => <li>{p}</li>)}</ul>
          </article>
        ))}
      </div>
      <p class="tfrr-note">
        현금으로 받은 외화를 원화로 다시 바꾸는 비용은
        <a href={withBase("/tools/travel-exchange-calculator/")}>여행 환전 손익 계산기</a>에서 비교해 보세요.
      </p>
    </section>

    {/* 6. 입국 면세한도 */}
    <section class="op-section">
      <div class="tfrr-warning">
        <strong>택스프리 환급 ≠ 한국 입국 면세한도</strong>
        <p>
          택스프리는 여행한 나라의 부가세를 돌려받는 제도입니다. 한국에 들어올 때 적용되는 면세한도(1인 미화 800달러)와는 별개라서,
          택스프리를 받았더라도 면세한도를 넘으면 한국 세관에 신고하고 세금을 내야 합니다.
        </p>
      </div>
    </section>

    {/* 7. CTA */}
    <section class="op-section tfrr-cta">
      <div>
        <p class="section-header__eyebrow">내 쇼핑 금액으로 계산</p>
        <h2>얼마 돌려받는지, 얼마 더 사야 하는지 바로 계산해 보세요</h2>
        <p>나라와 결제 금액을 넣으면 최대 환급액과 최소금액 부족분을 원화로 보여줍니다.</p>
      </div>
      <a href={withBase("/tools/tax-free-refund-calculator/")}>택스프리 환급액 계산기</a>
    </section>

    <SeoContent
      introTitle="해외 택스프리 2026 — 나라별 최소금액과 환급 방법 총정리"
      intro={TFRR_SEO_INTRO}
      criteria={TFRR_CRITERIA}
      faq={TFRR_FAQ}
      related={TFRR_RELATED_LINKS}
    />
  </main>
</BaseLayout>
