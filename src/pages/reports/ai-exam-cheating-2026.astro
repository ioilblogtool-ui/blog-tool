---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import CalculatorHero from "../../components/CalculatorHero.astro";
import InfoNotice from "../../components/InfoNotice.astro";
import SeoContent from "../../components/SeoContent.astro";
import {
  EXAM_META, examCases, examFaq, examRelated, examRules, examSources, examTimeline,
} from "../../data/aiExamCheating2026";

const canonicalUrl = `https://bigyocalc.com/reports/${EXAM_META.slug}/`;
const sourceById = new Map<string, (typeof examSources)[number]>(
  examSources.map((source) => [source.id, source]),
);
const sourceLinks = (ids: readonly string[]) => ids.map((id) => {
  const source = sourceById.get(id);
  if (!source) throw new Error(`Unknown exam report source: ${id}`);
  return source;
});
const sections = [
  ["csat", "수능 안내"],
  ["cases", "확인된 사례"],
  ["rules", "시험별 규정"],
  ["assessment", "평가 방식 변화"],
  ["sources", "출처"],
  ["faq", "자주 묻는 질문"],
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: EXAM_META.title,
  description: EXAM_META.description,
  inLanguage: "ko-KR",
  mainEntityOfPage: canonicalUrl,
  image: new URL(EXAM_META.ogImage, canonicalUrl).href,
  author: { "@type": "Organization", name: "비교계산소" },
  publisher: { "@type": "Organization", name: "비교계산소" },
};
---

<BaseLayout title={EXAM_META.title} description={EXAM_META.description} canonicalUrl={canonicalUrl} ogImage={EXAM_META.ogImage} jsonLd={jsonLd}>
  <SiteHeader />
  <main class="container page-shell report-page aec-page" data-report={EXAM_META.slug}>
    <div id="overview">
      <CalculatorHero eyebrow="시험 규정 비교" title={EXAM_META.title} description={EXAM_META.description} />
      <InfoNotice title="조사 기준일 · 2026년 11월 18일" lines={[
        "2027학년도 수능은 2026년 11월 19일 시행 예정입니다. 교육부는 11월 18일 강화된 수험생 유의사항을 추가 안내했습니다.",
        "국가자격시험에서는 스마트안경 관련 적발·수사의뢰가 발표됐고, 세무사 시험에서는 별도의 처분 절차가 시작됐습니다.",
      ]} />
      <nav class="aec-nav" aria-label="리포트 목차">
        {sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </nav>
    </div>

    <section class="content-section aec-section" id="csat" aria-labelledby="aec-csat-title">
      <h2 id="aec-csat-title">2027학년도 수능 수험생 안내</h2>
      <p>스마트안경 등 반입 금지 전자기기는 시험장에 가져가지 마세요. 부득이하게 가져온 경우 전원을 끄고 1교시 시작 전에 감독관에게 제출하세요. 안경을 쓰는 수험생은 감독관의 확인에 협조하고, 의료상 필요한 기기나 시험 편의는 관할 교육청에 확인하세요.</p>
      <p><a href={sourceById.get("edu")?.url}>교육부 11월 18일 수험생 유의사항</a></p>
      <ol class="aec-timeline">
        {examTimeline.map(([date, status, summary, ids]) => (
          <li>
            <time datetime={date}>{date}</time>
            <h3>{status}</h3>
            <p>{summary}</p>
            <p class="aec-links">{sourceLinks(ids).map((source) => <a href={source.url} aria-label={`${source.publisher} ${source.title}`}>{source.publisher} 자료</a>)}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="content-section aec-section" id="cases" aria-labelledby="aec-cases-title">
      <h2 id="aec-cases-title">시험에서 확인된 사례</h2>
      <p>근거와 진행 상태를 함께 표시했습니다. 적발 건수는 발표 기관이 확인한 범위입니다.</p>
      <div class="aec-cases">
        {examCases.map(([id, name, period, evidence, stage, summary, ids]) => (
          <article class="aec-case" id={id}>
            <p class="aec-case-meta"><span class="aec-badge" data-evidence={evidence}>{evidence}</span> {stage} · {period}</p>
            <h3>{name}</h3>
            <p>{summary}</p>
            <p class="aec-links">{sourceLinks(ids).map((source) => <a href={source.url} aria-label={`${source.publisher} ${source.title}`}>{source.publisher} 자료</a>)}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section aec-section" id="rules" aria-labelledby="aec-rules-title">
      <h2 id="aec-rules-title">시험별 금지 행위와 처분</h2>
      <div class="aec-table-wrap" tabindex="0" role="region" aria-labelledby="aec-rules-title">
        <table>
          <caption>시험 유형별 적용 요건, 제재 및 확인 기관</caption>
          <thead><tr><th scope="col">시험</th><th scope="col">행위</th><th scope="col">처분 기준</th><th scope="col">확인 기관·자료</th></tr></thead>
          <tbody>
            {examRules.map(([exam, conduct, consequence, authority, ids]) => (
              <tr>
                <th scope="row">{exam}</th>
                <td>{conduct}</td>
                <td>{consequence}</td>
                <td>{authority}<div class="aec-links">{sourceLinks(ids).map((source) => <a href={source.url} aria-label={`${source.publisher} ${source.title}`}>{source.publisher}</a>)}</div></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>교육부는 계획적·고의적 부정행위에 대해 수사 의뢰 등 법적 대응 가능성도 안내했습니다. <a href={sourceById.get("rules")?.url}>교육부 스마트안경 제재 안내</a></p>
    </section>

    <section class="content-section aec-section" id="assessment" aria-labelledby="aec-assessment-title">
      <h2 id="aec-assessment-title">AI 시대에 달라지는 평가 방식</h2>
      <div class="aec-cases">
        <article class="aec-case">
          <h3>도움 없이 수행하는 능력 확인</h3>
          <p>감독형 시험이나 짧은 구술 평가를 활용하면 학생이 핵심 개념을 이해하고 설명할 수 있는지 확인할 수 있습니다. 구술은 추가 채점 시간이 필요하며, 장애 학생을 위한 응시 편의와 일관된 평가 기준도 마련해야 합니다.</p>
        </article>
        <article class="aec-case">
          <h3>AI 활용과 검증 과정 평가</h3>
          <p>AI 사용을 허용하는 과제라면 사용 목적·범위와 결과 검증 과정을 제출하게 할 수 있습니다. 채점 기준과 이용 가능한 도구를 사전에 안내하고, 의심 사례에는 증거 검토와 소명 절차를 둡니다.</p>
        </article>
      </div>
      <p class="aec-links">{sourceLinks(["yonsei", "teqsa"]).map((source) => <a href={source.url}>{source.publisher} · {source.title}</a>)}</p>
    </section>

    <section class="content-section aec-section" id="sources" aria-labelledby="aec-sources-title">
      <h2 id="aec-sources-title">자료 출처와 갱신 기준</h2>
      <p>공식은 시행기관·정부의 원자료, 참고는 기관 원문을 확보하지 못한 보도입니다. 개별 사례의 건수와 조사 대상 종목 수는 각 자료의 집계 단위를 따릅니다. 전국 발생률을 계산할 수 있는 공통 기준과 응시자 분모는 이 자료에 포함되지 않았습니다.</p>
      <ul class="aec-source-list">
        {examSources.map((source) => (
          <li><a href={source.url}>{source.publisher} · {source.title}</a>{source.publishedAt && ` · 발표 ${source.publishedAt}`} · 확인 <time datetime={source.checkedAt}>{source.checkedAt}</time></li>
        ))}
      </ul>
      <p><strong>갱신 이력</strong> · <time datetime={EXAM_META.asOf}>{EXAM_META.asOf}</time> 수능 시행 전 자료 기준. 시험 이후 전체·스마트기기·AI 관련 집계의 공개 여부와 심의 결과를 확인합니다.</p>
    </section>

    <SeoContent
      introTitle="시험 전에 확인할 기준"
      introSummary="응시하는 시험의 최신 공고와 허용 범위를 확인하세요."
      intro={[
        "수험생은 시험마다 허용 물품과 제출 시점이 다르므로 자신에게 적용되는 안내를 먼저 확인해야 합니다.",
        "사례는 적발, 수사의뢰, 처분 개시 등 자료로 확인할 수 있는 단계까지 표시했습니다.",
        "국가자격시험은 종목별 규정을, 대학 교과 평가는 학교 지침과 수업별 허용 범위를 따릅니다.",
        "수능 집계와 진행 중인 사건은 시행기관의 후속 발표를 기준으로 다시 확인합니다.",
      ]}
      faq={examFaq}
      related={examRelated}
      relatedTitle="관련 콘텐츠"
      relatedEyebrow="AI 학습"
      relatedLinkLabel="콘텐츠 보기"
      relatedSummary="AI 학습 도구의 비용과 활용 범위를 확인하세요."
    />
  </main>
</BaseLayout>
