---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import CalculatorHero from "../../components/CalculatorHero.astro";
import InfoNotice from "../../components/InfoNotice.astro";
import SeoContent from "../../components/SeoContent.astro";
import {
  KSR_META,
  KSR_SOURCES,
  KSR_SNAPSHOTS,
  KSR_EVENTS_2026,
  KSR_2008,
  KSR_COUNT_NOTE,
  KSR_CRASH_REPORT_LINK,
  KSR_MARKET_CONDITIONS,
  KSR_MECHANISM_COMPARISON,
  KSR_CB_STAGES,
  KSR_CAUSE_CARDS,
  KSR_CHECKLIST,
  KSR_AVOID_LIST,
  KSR_FAQ,
  KSR_RELATED_LINKS,
} from "../../data/kospiSidecarRecord2026";

import {
  validateSnapshots,
  validateEvents,
  latestSnapshot,
  ratio,
  increments,
  formatDateKo,
} from "../../utils/kospiSidecarRecord2026";

validateSnapshots(KSR_SNAPSHOTS, KSR_SOURCES);
validateEvents(KSR_EVENTS_2026, KSR_SOURCES);

const kospi = latestSnapshot(KSR_SNAPSHOTS, "코스피");
const kosdaq = latestSnapshot(KSR_SNAPSHOTS, "코스닥");
if (!kospi || kospi.total === null) throw new Error("[ksr] 코스피 최신 스냅샷 없음");
const kospiTotal = kospi.total;
const vs2008 = ratio(kospiTotal, KSR_2008.kospi);
const buyShare = kospi.buy !== null ? ratio(kospi.buy, kospiTotal) : null;
const kospiCbLatest = KSR_EVENTS_2026.filter((e) => e.market === "코스피" && e.kind.startsWith("서킷") && e.status === "확정").at(-1);
const kospiCbCount = kospiCbLatest?.ordinalNote?.match(/올해 (\d+)번째/)?.[1] ?? null;
const kospiSnapshots = KSR_SNAPSHOTS.filter((s) => s.market === "코스피");
const maxTotal = Math.max(...kospiSnapshots.map((s) => s.total ?? 0));
const deltas = new Map(increments(KSR_SNAPSHOTS, "코스피").map((d) => [d.asOf, d.delta]));
const octoberEvents = KSR_EVENTS_2026.filter((e) => e.status === "확정" && e.date.startsWith("2026-10"));
const cbEvents = KSR_EVENTS_2026.filter((e) => e.status === "확정" && e.kind.startsWith("서킷"));
const sourceById = new Map(KSR_SOURCES.map((src) => [src.id, src]));
const badgeClass = (b: string) => ({ 공식: "official", 참고: "ref", 시뮬레이션: "sim", 추정: "est" })[b] ?? "ref";
const asOfLabel = formatDateKo(kospi.asOf);
const fmtRatio = (v: number) => v.toFixed(2);
const fmtPct1 = (v: number) => (v * 100).toFixed(1);

const hasCrashReport = Object.keys(import.meta.glob("./kospi-october-crash-2026.astro")).length > 0;
const relatedLinks = hasCrashReport ? [KSR_CRASH_REPORT_LINK, ...KSR_RELATED_LINKS] : KSR_RELATED_LINKS;

const seoIntro = [
  "사이드카는 선물시장의 급격한 가격 변동이 현물시장의 프로그램매매로 그대로 번지는 것을 막기 위한 장치입니다. 코스피는 코스피200 선물이 전일 기준가격보다 5% 이상 오르거나 내린 상태가 1분 동안 이어지면 발동되고, 코스닥은 코스닥150 선물 6%와 현물지수 3%가 같은 방향으로 함께 움직여야 발동됩니다. 발동되면 시장 전체가 멈추는 것이 아니라 프로그램매매 호가의 효력만 5분간 정지됩니다.",
  `2026년 코스피 사이드카는 ${asOfLabel} 기준 ${kospiTotal}회(매도 ${kospi.sell}회·매수 ${kospi.buy}회)로 재구성됩니다. 매도와 매수가 거의 같은 횟수로 발동됐다는 점이 특징인데, 급락한 다음 날 급반등하고 다시 급락하는 장세가 반복됐다는 뜻입니다. 이 수치는 언론이 인용한 한국거래소 집계를 시점별로 모은 잠정값이며, 2008년 금융위기 당시 코스피 ${KSR_2008.kospi}회와 비교하면 약 ${fmtRatio(vs2008)}배입니다.`,
  "10월에는 반도체 대형주 급락과 함께 사이드카가 다시 잦아졌습니다. 10월 13일 오전 9시 47분 매도 사이드카가 발동됐고, 10월 15일에는 개장 직후 코스피·코스닥 매도 사이드카에 이어 낮 12시대에 두 시장 모두 서킷브레이커가 발동돼 20분간 거래가 멈췄습니다. 반대로 10월 27일에는 코스피가 장중 4% 넘게 오르며 오전 10시 13분 매수 사이드카가 발동됐습니다.",
  "사이드카는 매수·매도 신호가 아니라 단기 변동이 지나치게 컸다는 표시입니다. 매수 사이드카가 바닥을, 매도 사이드카가 추가 폭락을 뜻하지 않으며, 2008년과의 횟수 비교도 위기의 크기를 비교한 것이 아닙니다. 발동된 날에는 선물 움직임, 외국인 수급, 환율, 대형주 집중도를 함께 확인하고 시장가 대량 주문이나 레버리지 상품 추격은 피하는 것이 일반적인 위험관리 방법입니다.",
];

const siteBase = (import.meta.env.SITE ?? "https://bigyocalc.com").replace(/\/$/, "");
const reportUrl = `${siteBase}/reports/${KSR_META.slug}/`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: KSR_META.title,
    description: KSR_META.seoDescription,
    dateModified: KSR_META.updatedAt,
    mainEntityOfPage: reportUrl,
    author: { "@type": "Organization", name: "비교계산소" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: KSR_FAQ.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "홈", item: siteBase },
      { "@type": "ListItem", position: 2, name: "리포트", item: `${siteBase}/reports/` },
      { "@type": "ListItem", position: 3, name: KSR_META.title, item: reportUrl },
    ],
  },
];
---
<BaseLayout title={KSR_META.seoTitle} description={KSR_META.seoDescription} ogImage="/og/reports/kospi-sidecar-record-2026.png" jsonLd={jsonLd}>
  <SiteHeader />

  <main class="container page-shell report-page op-page ksr-page" data-report="kospi-sidecar-record-2026">
    <CalculatorHero
      eyebrow="2026년 증시 변동성"
      title={KSR_META.title}
      description={KSR_META.description}
    />

    <p class="ksr-asof-badge">데이터 기준일: {KSR_META.updatedAt}</p>

    <InfoNotice
      title="읽기 전 꼭 확인하세요"
      lines={[
        KSR_META.dataNote,
        "이 리포트는 투자를 추천하지 않습니다.",
      ]}
    />

    <section class="op-section">
      <h2>2026년 누적 발동 현황</h2>
      <div class="op-card-grid">
        <article class="report-stat-card report-stat-card--primary">
          <strong>{kospiTotal}회</strong>
          <p>코스피 사이드카 누적 <span class={`ksr-badge ksr-badge--${badgeClass(kospi.badge)}`}>{kospi.badge}</span></p>
          <small>{asOfLabel} 기준 · 재구성 잠정값</small>
        </article>
        <article class="report-stat-card">
          <strong>{kospi.sell}회</strong>
          <p>매도 사이드카</p>
          <small>급락 때 발동</small>
        </article>
        <article class="report-stat-card">
          <strong>{kospi.buy}회</strong>
          <p>매수 사이드카</p>
          <small>급등 때 발동{buyShare !== null && ` · 전체의 ${fmtPct1(buyShare)}%`}</small>
        </article>
        <article class="report-stat-card">
          <strong>{kospiCbCount ? `${kospiCbCount}회` : "확인 중"}</strong>
          <p>코스피 서킷브레이커</p>
          <small>{kospiCbLatest ? `${formatDateKo(kospiCbLatest.date)} 발동이 올해 ${kospiCbCount}번째` : "한국거래소 공지 확인 중"}</small>
        </article>
      </div>
      <p class="op-message">
        코스닥은 7월 24일 보도 기준 {kosdaq?.total}회(매도 {kosdaq?.sell}회·매수 {kosdaq?.buy}회)까지 확인됐고, 이후 누적은 다시 조사하고 있습니다.
      </p>
    </section>

    <section class="op-section ksr-trend">
      <h2>코스피 사이드카 누적 추이</h2>
      <ol class="ksr-trend__list">
        {kospiSnapshots.map((snap) => (
          <li class="ksr-trend__row">
            <span class="ksr-trend__date">{formatDateKo(snap.asOf)}</span>
            <span class="ksr-trend__bar" style={`width:${((snap.total ?? 0) / maxTotal) * 100}%`}>
              {snap.sell !== null && snap.buy !== null ? (
                <>
                  <span class="ksr-trend__sell" style={`flex:${snap.sell}`}>매도 {snap.sell}</span>
                  <span class="ksr-trend__buy" style={`flex:${snap.buy}`}>매수 {snap.buy}</span>
                </>
              ) : (
                <span class="ksr-trend__unknown">방향 미공개</span>
              )}
            </span>
            <span class="ksr-trend__total">
              {snap.total}회
              {deltas.get(snap.asOf) !== null && deltas.get(snap.asOf) !== undefined && <small> (+{deltas.get(snap.asOf)})</small>}
            </span>
            <span class={`ksr-badge ksr-badge--${badgeClass(snap.badge)}`}>{snap.badge}</span>
          </li>
        ))}
      </ol>
      <p class="op-message">언론이 인용한 한국거래소 집계를 시점별로 모은 값입니다. 괄호는 직전 시점 대비 증가 횟수입니다.</p>
    </section>

    <section class="op-section">
      <h2>10월 급락·반등 때 발동 기록</h2>
      <table class="ksr-table ksr-table--cards">
        <thead>
          <tr><th>날짜</th><th>시장</th><th>구분</th><th>시각</th><th>비고</th></tr>
        </thead>
        <tbody>
          {octoberEvents.map((ev) => (
            <tr>
              <td data-label="날짜">{formatDateKo(ev.date)}</td>
              <td data-label="시장">{ev.market}</td>
              <td data-label="구분">{ev.kind}</td>
              <td data-label="시각">{ev.time ?? "—"}</td>
              <td data-label="비고">{[ev.ordinalNote, ev.context].filter(Boolean).join(" · ")}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="op-message">
        10월 27일 발동이 '올해 매수 26번째'로 보도돼 10월 16~26일 사이에 매수 사이드카가 한 번 더 있었던 것으로 보이지만, 발동일은 확인 중이라 표에 넣지 않았습니다.
        {hasCrashReport && <> 10월 급락의 원인과 수급은 <a href={KSR_CRASH_REPORT_LINK.href}>{KSR_CRASH_REPORT_LINK.label}</a>에서 볼 수 있습니다.</>}
      </p>
    </section>

    <section class="op-section">
      <h2>역대 비교 — 2008년 금융위기 vs 2026년</h2>
      <table class="ksr-table">
        <thead>
          <tr><th>구분</th><th>2008년(금융위기)</th><th>2026년({asOfLabel}까지)</th></tr>
        </thead>
        <tbody>
          <tr><td>코스피 사이드카</td><td>{KSR_2008.kospi}회</td><td>{kospiTotal}회 (약 {fmtRatio(vs2008)}배 <span class="ksr-badge ksr-badge--sim">시뮬레이션</span>)</td></tr>
          <tr><td>코스닥 사이드카</td><td>{KSR_2008.kosdaq}회</td><td>{kosdaq?.total}회 이상 (7월 24일 기준, 이후 재조사 중)</td></tr>
        </tbody>
      </table>
      <p class="op-message">
        횟수 비교일 뿐 위기의 크기를 비교한 것이 아닙니다. 2026년에는 매수 사이드카가 전체의 절반 가까이를 차지해 하락 일변도였던 2008년과 성격이 다르고, 프로그램매매·선물 거래 규모도 달라졌습니다. 2008년 수치는 연간 최종값, 2026년 수치는 연중 집계 중인 값입니다.
      </p>
    </section>

    <section class="op-section">
      <h2>사이드카란?</h2>
      <p class="op-message">
        사이드카는 선물시장의 급격한 가격 변동이 현물시장 프로그램매매로 그대로 확산되는 것을 완화하기 위한 장치입니다.
        발동되면 모든 주식 거래가 정지되는 것이 아니라, 프로그램매매 호가의 효력만 5분간 정지됩니다.
        선물 가격이 급등할 때는 매수 사이드카, 급락할 때는 매도 사이드카가 각각 발동됩니다.
      </p>
    </section>

    <section class="op-section">
      <h2>코스피·코스닥 발동 조건</h2>
      <table class="ksr-table">
        <thead>
          <tr><th>시장</th><th>선물 가격 조건</th><th>현물지수 조건</th><th>지속시간</th><th>조치</th></tr>
        </thead>
        <tbody>
          {KSR_MARKET_CONDITIONS.map((row) => (
            <tr>
              <td>{row.market}</td>
              <td>{row.futuresCondition}</td>
              <td>{row.spotCondition}</td>
              <td>{row.duration}</td>
              <td>{row.action}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="op-section">
      <h2>사이드카와 서킷브레이커 차이</h2>
      <table class="ksr-table">
        <thead>
          <tr><th>구분</th><th>사이드카</th><th>서킷브레이커</th></tr>
        </thead>
        <tbody>
          {KSR_MECHANISM_COMPARISON.map((row) => (
            <tr><td>{row.label}</td><td>{row.sidecar}</td><td>{row.circuitBreaker}</td></tr>
          ))}
        </tbody>
      </table>

      <h3>서킷브레이커 단계</h3>
      <table class="ksr-table">
        <thead>
          <tr><th>단계</th><th>주요 발동 조건</th><th>조치</th></tr>
        </thead>
        <tbody>
          {KSR_CB_STAGES.map((row) => (
            <tr><td>{row.stage}</td><td>{row.condition}</td><td>{row.action}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="op-message">쉽게 말하면 사이드카는 프로그램매매에 거는 일시적인 제동장치이고, 서킷브레이커는 시장 전체를 멈추는 비상정지 장치입니다.</p>

      <h3>2026년 서킷브레이커 기록 (보도로 확인된 건)</h3>
      <table class="ksr-table ksr-table--cards">
        <thead>
          <tr><th>날짜</th><th>시장</th><th>시각</th><th>비고</th></tr>
        </thead>
        <tbody>
          {cbEvents.map((ev) => (
            <tr>
              <td data-label="날짜">{formatDateKo(ev.date)}</td>
              <td data-label="시장">{ev.market}</td>
              <td data-label="시각">{ev.time ?? "—"}</td>
              <td data-label="비고">{[ev.ordinalNote, ev.context].filter(Boolean).join(" · ")}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="op-message">전체 발동 이력이 아니라 보도로 시각과 횟수가 확인된 건만 정리했습니다.</p>
    </section>

    <section class="op-section">
      <h2>2026년 변동성을 키운 것으로 거론되는 배경</h2>
      <div class="ksr-cause-grid">
        {KSR_CAUSE_CARDS.map((c) => (
          <article class="ksr-mechanism-card">
            <strong>{c.title}</strong>
            <p>{c.detail}</p>
          </article>
        ))}
      </div>
      <p class="op-message">위 항목은 시장 변동성 확대 배경으로 언론과 시장에서 거론되는 요인을 정리한 것입니다. 각 사이드카 발동의 원인을 한국거래소가 공식적으로 확정한 것은 아닙니다.</p>
    </section>

    <section class="op-section">
      <h2>사이드카 발동 시 확인할 5가지</h2>
      <table class="ksr-table">
        <thead>
          <tr><th>확인 항목</th><th>체크 내용</th></tr>
        </thead>
        <tbody>
          {KSR_CHECKLIST.map((item) => (
            <tr><td>{item.title}</td><td>{item.detail}</td></tr>
          ))}
        </tbody>
      </table>

      <h3>투자자가 피해야 할 행동</h3>
      <ul class="ksr-avoid-list">
        {KSR_AVOID_LIST.map((item) => <li>{item}</li>)}
      </ul>
      <p class="op-message">
        변동성이 극심한 날에는 시장가 주문보다 지정가 주문이 가격 통제에 유리할 수 있습니다.
        매수 계획이 있더라도 한 번에 집행하지 않고 시간과 가격을 나눠 접근하는 방식이 급격한 가격 변동 위험을 줄이는 데 도움이 될 수 있습니다.
        다만 이는 일반적인 위험관리 방식이며 수익을 보장하지 않습니다.
      </p>
    </section>

    <section class="op-section">
      <h2>'올해 N번째' 집계 기준 안내</h2>
      <ul class="ksr-count-note">
        {KSR_COUNT_NOTE.map((line) => <li>{line}</li>)}
      </ul>
    </section>

    <section class="op-section">
      <h2>출처</h2>
      <ul class="ksr-source-list">
        {KSR_SOURCES.map((src) => (
          <li>
            <a href={src.url} target="_blank" rel="noopener noreferrer">{src.org} · {src.title}</a>
            <small>{src.publishedAt}</small>
          </li>
        ))}
      </ul>
      <p class="op-message">발동 조건은 한국거래소 유가증권·코스닥시장 업무규정 기준이며, 누적 횟수는 위 보도가 인용한 한국거래소 집계를 바탕으로 재구성했습니다.</p>
    </section>

    <SeoContent
