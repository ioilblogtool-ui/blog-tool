---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import CalculatorHero from '../../components/CalculatorHero.astro';
import InfoNotice from '../../components/InfoNotice.astro';
import SeoContent from '../../components/SeoContent.astro';
import { YETS_META, YETS_RULES, YETS_CHECKLIST, YETS_CARD_GUIDE, YETS_EVIDENCE_NOTES,
  YETS_EXAMPLES, YETS_FAQ, YETS_INTRO, YETS_RELATED_LINKS, YETS_SOURCES, YETS_UPDATES,
} from '../../data/yearEndTaxSavingGuide2026';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => base + path;
const manWon = (amount: number) => `${(amount / 10000).toLocaleString('ko-KR')}만원`;
const percent = (rate: number) => `${Math.round(rate * 100)}%`;
const canonical = `https://bigyocalc.com/reports/${YETS_META.slug}/`;
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Article', headline: YETS_META.title, description: YETS_META.description,
    dateModified: YETS_META.updatedAt, inLanguage: 'ko-KR', mainEntityOfPage: canonical,
    publisher: { '@type': 'Organization', name: '비교계산소', url: 'https://bigyocalc.com' } },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: 'https://bigyocalc.com/' },
    { '@type': 'ListItem', position: 2, name: '리포트', item: 'https://bigyocalc.com/reports/' },
    { '@type': 'ListItem', position: 3, name: YETS_META.title, item: canonical },
  ] },
  { '@type': 'FAQPage', mainEntity: YETS_FAQ.map(item => ({ '@type': 'Question', name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer } })) },
] };
---

<BaseLayout title={YETS_META.seoTitle} description={YETS_META.description} jsonLd={jsonLd}
  ogImage="/og/og-home.png" ogType="article" recordSessions={false} loadAds={false}>
  <SiteHeader />
  <main class="container page-shell report-page yets-page">
    <nav class="yets-breadcrumb" aria-label="현재 위치">
      <a href={withBase('/')}>홈</a><span aria-hidden="true">/</span>
      <a href={withBase('/reports/')}>리포트</a><span aria-hidden="true">/</span><span>연말정산</span>
    </nav>
    <CalculatorHero eyebrow="2026년 귀속 · 2027년 정산" title={YETS_META.title}
      description="연말까지 확인할 공제와 증빙을 점검하고, 내 조건의 예상 소득세와 환급액을 확인하세요." />
    <p class="yets-reviewed">공식 안내 확인 <time datetime={YETS_META.updatedAt}>{YETS_META.updatedAt}</time></p>
    <div class="yets-actions">
      <a class="button button--primary" href={withBase(YETS_META.calculatorHref)}>내 조건으로 예상 환급액 계산하기</a>
      <a class="button button--secondary" href="#yets-checklist">준비 체크리스트 보기</a>
    </div>
    <InfoNotice title="준비 전에 확인하세요" lines={[YETS_META.dataNote,
      '소득공제액·세액공제액·환급액은 다릅니다. 환급액은 이미 낸 세금과 결정세액의 차이입니다.',
      '연결된 계산기는 소득세 기준 시뮬레이션이며 지방소득세를 합산하지 않습니다. 기납부 소득세를 비워두면 환급액을 임의 추정하지 않습니다.',
    ]} />

    <section class="content-section" aria-labelledby="yets-start-heading">
      <div class="section-header section-header--compact"><p class="yets-eyebrow">먼저 준비할 3가지</p><h2 id="yets-start-heading">내 숫자와 자료부터 확인하세요</h2></div>
      <div class="yets-three-grid">
        <article class="panel"><h3>예상 총급여</h3><p>비과세 급여를 제외한 올해 연간 예상액입니다. 현재 누적액만 확인했다면 남은 급여를 구분하세요.</p></article>
        <article class="panel"><h3>공제대상 지출·납입</h3><p>카드·월세·의료비와 연금계좌 내역을 모으세요. 결제 총액과 공제대상 금액은 다를 수 있습니다.</p></article>
        <article class="panel"><h3>이미 낸 소득세</h3><p>급여명세서 등에서 확인하세요. 이 값이 없으면 예상 결정세액을 먼저 보고, 환급은 따로 확인합니다.</p></article>
      </div>
    </section>

    <section id="yets-checklist" class="content-section" data-yets-checklist aria-labelledby="yets-checklist-heading">
      <div class="section-header section-header--compact"><p class="yets-eyebrow">나에게 해당하는 항목부터</p><h2 id="yets-checklist-heading">연말 공제 준비 체크리스트</h2></div>
      <p>‘해당 여부’는 점검할 항목, ‘준비 상태’는 자료를 챙긴 정도입니다. 준비 완료가 공제 승인이나 적격 판정을 의미하지는 않습니다.</p>
      <div class="yets-checklist-toolbar" data-yets-controls hidden>
        <p data-yets-status role="status" aria-live="polite" aria-atomic="true">6개 항목의 해당 여부부터 확인하세요.</p>
        <button type="button" class="button button--secondary" data-yets-reset>준비 상태 초기화</button>
      </div>
      <p class="yets-small">체크 상태는 이 페이지에서만 사용합니다. 주소·브라우저 저장소에 저장하지 않으며 새로고침하면 초기화됩니다.</p>
      <noscript><p class="notice-box">자바스크립트가 꺼져 있어 준비 상태 선택은 제공하지 않습니다. 아래 항목별 안내와 공식 출처는 그대로 읽을 수 있습니다.</p></noscript>
      <div class="yets-checklist-grid">
        {YETS_CHECKLIST.map((item, index) => <article class="panel yets-checklist-card" data-yets-item={item.id} data-prepared="false">
          <div class="yets-card-heading"><span class="yets-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.summary}</p></div></div>
          <div class="yets-select-grid" data-yets-controls hidden>
            <div><label for={`yets-${item.id}-applicability`}>{item.title} 해당 여부</label>
              <select id={`yets-${item.id}-applicability`} data-yets-field="applicability">
                <option value="unknown">아직 미확인</option><option value="applies">해당 항목 점검</option><option value="not_applicable">해당 없음</option>
              </select>
            </div>
            <div><label for={`yets-${item.id}-preparation`}>{item.title} 준비 상태</label>
              <select id={`yets-${item.id}-preparation`} data-yets-field="preparation" disabled aria-describedby="yets-preparation-help">
                <option value="unchecked">아직 미확인</option><option value="in_progress">확인 중</option><option value="ready">준비 완료</option>
              </select>
            </div>
          </div>
          <dl class="yets-item-details"><dt>지금 확인</dt><dd>{item.checkNow}</dd><dt>연말까지 할 일</dt><dd>{item.action}</dd><dt>챙길 자료</dt><dd>{item.documents}</dd></dl>
          <details class="yets-details"><summary>{item.title} 적용 전 주의할 점</summary><p>{item.caution}</p><a href={`#${item.anchor}`}>관련 설명 읽기</a><span aria-hidden="true"> · </span>{item.sourceIds.map(id => <a class="yets-source-link" href={`#yets-source-${id}`}>공식 근거</a>)}</details>
        </article>)}
      </div>
      <p id="yets-preparation-help" class="yets-small">‘해당 항목 점검’을 선택하면 준비 상태를 바꿀 수 있습니다. 해당 없음이나 미확인으로 바꾸면 준비 상태도 초기화됩니다.</p>
    </section>

    <section id="yets-card" class="content-section" aria-labelledby="yets-card-heading">
      <div class="section-header section-header--compact"><p class="yets-eyebrow">카드 사용 전략</p><h2 id="yets-card-heading">남은 지출은 같은 금액으로 비교하세요</h2></div>
      <div class="yets-three-grid">{YETS_CARD_GUIDE.map(item => <article class="panel"><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
      <p class="yets-callout">카드 공제의 일반 문턱은 총급여의 {percent(YETS_RULES.cardThresholdRate)}입니다. 한도를 채우기 위한 추가 소비보다 원래 예정한 지출을 기준으로 비교하세요. <a href="#yets-source-card">공식 기준 확인</a></p>
      <a class="button button--secondary" href={withBase(YETS_META.calculatorHref)}>계산기에서 카드 결제수단 비교하기</a>
    </section>

    <section id="yets-retirement" class="content-section" aria-labelledby="yets-retirement-heading">
      <div class="section-header section-header--compact"><p class="yets-eyebrow">연금저축·IRP</p><h2 id="yets-retirement-heading">남은 공제 여력과 생활자금을 함께 보세요</h2></div>
      <div class="panel yets-retirement-panel">
        <div class="yets-three-grid">
          <div><span class="yets-small">연금저축 일반 공제대상 한도</span><strong class="yets-value">{manWon(YETS_RULES.pensionSavingCap)}</strong></div>
          <div><span class="yets-small">퇴직연금 포함 일반 합산 한도</span><strong class="yets-value">{manWon(YETS_RULES.pensionCombinedCap)}</strong></div>
          <div><span class="yets-small">소득세 공제율 · 소득 요건별</span><strong class="yets-value">{percent(YETS_RULES.pensionLowRate)} / {percent(YETS_RULES.pensionHighRate)}</strong></div>
        </div>
        <p>위 값은 적격 본인 납입액의 일반 세액공제 기준이며 계좌에 넣을 수 있는 전체 한도와 다릅니다. 총급여 {manWon(YETS_RULES.pensionSalaryBoundary)} 이하 등 적용 소득 요건을 확인하세요. ISA 전환 등 특례와 퇴직금·계좌 이전은 별도로 구분합니다. <a href="#yets-source-pension">공식 조건 확인</a></p>
        <p>추가 납입 전 생활자금과 중도인출·해지 조건, 금융기관의 연말 처리 마감을 확인하세요. 기존 계산기는 명목 공제 증가와 실제 예상 소득세 감소를 나눠 보여줍니다.</p>
        <a class="button button--primary" href={withBase(YETS_META.calculatorHref)}>연금 추가 납입의 소득세 효과 비교하기</a>
      </div>
    </section>

    <section id="yets-evidence" class="content-section" aria-labelledby="yets-evidence-heading">
      <div class="section-header section-header--compact"><p class="yets-eyebrow">요건과 증빙</p><h2 id="yets-evidence-heading">월세·의료비·가족 자료를 대조하세요</h2></div>
      <div class="yets-three-grid">{YETS_EVIDENCE_NOTES.map(item => <article class="panel"><h3>{item.title}</h3><p>{item.body}</p><a href={`#yets-source-${item.sourceId}`}>공식 안내 확인</a></article>)}</div>
    </section>

    <section class="content-section" aria-labelledby="yets-examples-heading">
      <div class="section-header section-header--compact"><p class="yets-eyebrow">세 가지 가상 사례</p><h2 id="yets-examples-heading">공제액과 환급액은 어떻게 다를까요?</h2></div>
      <div class="yets-three-grid">{YETS_EXAMPLES.map(item => <article id={item.id} class="panel"><span class="yets-example-label">{item.label}</span><h3>{item.title}</h3><p class="yets-example-value">{item.value}</p><p>{item.explanation}</p></article>)}</div>
    </section>

    <section class="panel yets-final-cta" aria-labelledby="yets-next-heading">
      <div><p class="yets-eyebrow">다음 단계</p><h2 id="yets-next-heading">준비한 자료로 내 조건을 계산하세요</h2><p>총급여·공제대상 지출·납입액을 넣고, 기납부 소득세를 알고 있다면 함께 입력하세요. 계산기의 지원 범위와 제외 특례도 확인하세요.</p></div>
      <a class="button button--primary" href={withBase(YETS_META.calculatorHref)}>예상 소득세·환급액 계산하기</a>
    </section>

    <SeoContent introTitle="2026 귀속 연말정산 준비와 결과 읽는 법" intro={YETS_INTRO} faq={YETS_FAQ}
      related={YETS_RELATED_LINKS} introSummary="해당 항목과 증빙을 점검하고 공제·세금·환급을 구분하세요."
      inputPoints={['2026 귀속·2027 정산을 구분해 연말에 할 일 확인', '6개 항목의 해당 여부와 자료 준비 상태 점검', '기존 계산기로 카드·연금 추가 시나리오 비교']}
      criteria={['준비 완료는 공제 적격 판정이 아닙니다.', '숫자 사례는 가상 조건이며 소득세와 지방소득세의 범위를 구분합니다.', '연말 처리 마감과 회사의 자료 제출 일정은 각각 확인하세요.']}
      relatedTitle="준비를 이어가는 계산기와 리포트" relatedSummary="연말정산 계산과 연금계좌·보험료의 기준을 이어서 확인하세요." />

    <section class="panel yets-source-panel" aria-labelledby="yets-sources-heading">
      <h2 id="yets-sources-heading">공식 출처와 확인 범위</h2>
      <p>확인일 {YETS_META.updatedAt}. 공개 안내는 기준연도가 다를 수 있으므로 2026 귀속에 적용되는 법령과 개인 요건을 함께 확인하세요. 이 페이지는 모든 특례나 최종 신고액을 판정하지 않습니다.</p>
      <ol>{YETS_SOURCES.map(source => <li id={`yets-source-${source.id}`}><a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a><p>{source.publisher} · {source.locator}</p></li>)}</ol>
      <h3>수정 이력</h3><ul>{YETS_UPDATES.map(item => <li><time datetime={item.date}>{item.date}</time> · {item.text}</li>)}</ul>
    </section>
  </main>
  <script is:inline type="module" src={withBase('/scripts/2026-year-end-tax-saving-guide.js')}></script>
</BaseLayout>
