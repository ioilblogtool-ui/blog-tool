---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import CalculatorHero from "../../components/CalculatorHero.astro";
import InfoNotice from "../../components/InfoNotice.astro";
import SeoContent from "../../components/SeoContent.astro";
import {
  SNP_META,
  SNP_SUMMARY_CARDS,
  SNP_DEAL_ROLES,
  SNP_SCOPE_CAVEAT,
  SNP_INCLUDED_AREAS,
  SNP_RELATIONS,
  SNP_POWER_SCALE,
  SNP_POWER_NOTE,
  SNP_POWER_BOTTLENECKS,
  SNP_REVENUE_STAGES,
  SNP_POSITIVE_FACTORS,
  SNP_NEGATIVE_FACTORS,
  SNP_BONUS_CHECKPOINTS,
  SNP_COMPARISON,
  SNP_VALUE_CHAIN,
  SNP_PROGRESS,
  SNP_RISKS,
  SNP_FAQ,
  SNP_SEO_INTRO,
  SNP_SEO_CRITERIA,
} from "../../data/skhynixNvidiaPartnership2026";

const riskClass = (severity: string) => {
  if (severity === "높음") return "snp-risk-card--high";
  if (severity === "중간") return "snp-risk-card--mid";
  return "snp-risk-card--low";
};

const confirmClass = (status: string) => {
  if (status === "공식 발표") return "snp-confirm--yes";
  if (status === "추가 확인 필요") return "snp-confirm--check";
  return "snp-confirm--maybe";
};

const siteUrl = (import.meta.env.SITE ?? "https://bigyocalc.com").replace(/\/$/, "");
const pageUrl = `${siteUrl}/reports/skhynix-nvidia-partnership-2026/`;

const title = "SK하이닉스 엔비디아 5000억달러 협력 2026 | 2GW AI 팩토리 완전 정리";
const description = "SK그룹과 엔비디아의 5000억달러 이상 포괄적 AI 인프라 협력 LOI를 정리합니다. 5000억달러의 정확한 의미, HBM 공동개발, 2GW AI 팩토리 규모, 삼성·마이크론 비교까지 확인하세요.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": pageUrl,
  url: pageUrl,
  headline: title,
  description,
  inLanguage: "ko-KR",
  datePublished: "2026-07-27",
  dateModified: "2026-07-27",
};

const inputPoints = [
  "5,000억달러는 SK하이닉스의 확정 수주액이 아니라 AI 팩토리·GPU·메모리·클라우드를 포괄하는 사업 규모입니다.",
  "SK하이닉스에 직접 영향을 주는 부분은 HBM 등 차세대 AI 메모리 공급·공동개발입니다.",
  "2GW는 첫 AI 팩토리(2027년 목표)가 아니라 전체 확장 목표 규모라는 점을 구분해야 합니다.",
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <SiteHeader />
  <main class="container page-shell snp-page">

    <CalculatorHero
      eyebrow="SK하이닉스 · 엔비디아"
      title="SK하이닉스·엔비디아 5,000억달러 AI 협력 총정리"
      description="HBM 공동개발과 2GW AI 팩토리가 실제로 의미하는 것을 LOI 발표 원문 기준으로 정리합니다."
    />

    <div class="snp-conclusion">
      <p class="snp-conclusion__label">핵심 결론</p>
      <p class="snp-conclusion__text">이번 발표는 SK하이닉스가 엔비디아 차세대 GPU·AI 시스템 개발 초기 단계부터 메모리 설계에 참여하는 공동개발 파트너로 자리잡는다는 의미가 있습니다. 다만 5,000억달러는 SK그룹과 엔비디아가 추진할 전체 AI 인프라 사업 규모이며, SK하이닉스 매출은 향후 체결될 메모리 공급계약의 물량·가격·기간에 따라 별도로 결정됩니다.</p>
    </div>

    <InfoNotice
      title="SK하이닉스의 확정 수주액이 아닙니다"
      lines={[SNP_META.notice]}
    />

    <!-- ── 섹션 1: 핵심 요약 ──────────────────────── -->
    <section class="content-section" aria-labelledby="summary-title">
      <p class="snp-eyebrow">핵심 요약</p>
      <h2 id="summary-title" class="snp-section-title">SK하이닉스·엔비디아 협력, 한눈에 보기</h2>
      <div class="snp-summary-grid">
        {SNP_SUMMARY_CARDS.map((card) => (
          <article class="snp-summary-card">
            <p class="snp-summary-card__label">{card.label}</p>
            <p class="snp-summary-card__value">{card.value}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- ── 섹션 2: LOI 상세 내용 ──────────────────── -->
    <section class="content-section" aria-labelledby="role-title">
      <p class="snp-eyebrow">LOI 상세</p>
      <h2 id="role-title" class="snp-section-title">주체별 협력 내용</h2>
      <div class="snp-role-table-wrap">
        <table class="snp-role-table">
          <tbody>
            {SNP_DEAL_ROLES.map((row) => (
              <tr>
                <td>{row.entity}</td>
                <td>{row.content}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="snp-note">{SNP_SCOPE_CAVEAT}</p>
    </section>

    <!-- ── 섹션 3: 5,000억달러는 무엇을 합친 금액인가 ★ -->
    <section class="content-section" aria-labelledby="areas-title">
      <p class="snp-eyebrow">수치 해석</p>
      <h2 id="areas-title" class="snp-section-title">5,000억달러는 무엇을 합친 금액인가</h2>
      <p class="snp-section-desc">5,000억달러 이상이라는 수치는 단순한 HBM 구매금액이 아닙니다. AI 팩토리 건설부터 GPU 시스템, HBM 공급, 전력·냉각 인프라, 클라우드 서비스까지 장기간 발생할 수 있는 전체 사업 규모를 포괄하는 개념으로 해석해야 합니다.</p>
      <div class="snp-role-table-wrap">
        <table class="snp-role-table">
          <thead>
            <tr><th>영역</th><th>주요 내용</th></tr>
          </thead>
          <tbody>
            {SNP_INCLUDED_AREAS.map((row) => (
              <tr>
                <td>{row.area}</td>
                <td>{row.content}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="snp-note">따라서 5,000억달러 전체가 SK하이닉스 매출로 연결되는 구조는 아닙니다. SK하이닉스에 직접적으로 영향을 주는 부분은 HBM과 차세대 AI 메모리 공급, 공동개발, 반도체 제조 인프라 고도화입니다.</p>
    </section>

    <!-- ── 섹션 4: 기존 vs 향후 관계 ──────────────── -->
    <section class="content-section" aria-labelledby="relation-title">
      <p class="snp-eyebrow">핵심 포인트</p>
      <h2 id="relation-title" class="snp-section-title">기존 관계 vs 확대되는 관계</h2>
      <div class="snp-relation-table-wrap">
        <table class="snp-relation-table">
          <thead>
            <tr><th>구분</th><th>기존 관계</th><th>확대되는 관계</th></tr>
          </thead>
          <tbody>
            {SNP_RELATIONS.map((row) => (
              <tr>
                <td>{row.category}</td>
                <td>{row.before}</td>
                <td>{row.after}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="snp-section-desc">SK하이닉스와 엔비디아는 이번 발표 이전에도 이미 심층적인 공동 엔지니어링을 진행해 왔습니다. 이번 협력은 GPU·AI 시스템 로드맵 공유 → HBM 구조·성능 공동 최적화 → 장기 공급 및 적용처 확대로 이어지는 관계 확장을 의미합니다.</p>
    </section>

    <!-- ── 섹션 5: 2GW AI 팩토리 규모 해석 ★ ──────── -->
    <section class="content-section" aria-labelledby="scale-title">
      <p class="snp-eyebrow">2GW AI 팩토리</p>
      <h2 id="scale-title" class="snp-section-title">2GW AI 팩토리는 얼마나 큰 규모일까</h2>
      <p class="snp-section-desc">2GW는 최대 전력 수요 기준 2,000MW에 해당합니다. 일반적인 기업용 데이터센터 한 곳의 전력 사용량이 수십 MW 수준이라는 점을 고려하면, 최대 2GW는 여러 대형 데이터센터 캠퍼스를 합친 초대형 AI 인프라 규모입니다.</p>
      <div class="snp-role-table-wrap">
        <table class="snp-role-table">
          <thead>
            <tr><th>비교 대상</th><th>대략적인 규모</th></tr>
          </thead>
          <tbody>
            {SNP_POWER_SCALE.map((row) => (
              <tr>
                <td>{row.target}</td>
                <td>{row.scale}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="snp-note">{SNP_POWER_NOTE}</p>
      <p class="snp-section-desc snp-section-desc--tight">핵심 병목:</p>
      <ul class="snp-check-list">
        {SNP_POWER_BOTTLENECKS.map((item) => (
          <li class="snp-check-list__item">
            <span class="snp-check-list__icon">•</span>
            {item}
          </li>
        ))}
      </ul>
    </section>

    <!-- ── 섹션 6: 발표에서 매출까지 5단계 ★ ──────── -->
    <section class="content-section" aria-labelledby="stage-title">
      <p class="snp-eyebrow">실적 반영 과정</p>
      <h2 id="stage-title" class="snp-section-title">발표에서 매출까지, 5단계</h2>
      <div class="snp-stage-table-wrap">
        <table class="snp-stage-table">
          <thead>
            <tr><th>단계</th><th>내용</th><th>현재 상태</th></tr>
          </thead>
          <tbody>
            {SNP_REVENUE_STAGES.map((row) => (
              <tr>
                <td>{row.stage}</td>
                <td>{row.content}</td>
                <td>{row.status}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="snp-note">이번 발표가 SK하이닉스 매출에 즉시 반영되는 것은 아닙니다. 향후 본계약 체결, HBM 생산능력 확보, 고객 인증, 제품 인도 과정을 거쳐 실제 매출로 인식됩니다.</p>
    </section>

    <!-- ── 섹션 7: SK하이닉스에 미치는 영향 ───────── -->
    <section class="content-section" aria-labelledby="impact-title">
      <p class="snp-eyebrow">투자 판단</p>
      <h2 id="impact-title" class="snp-section-title">SK하이닉스에 미치는 영향</h2>
      <div class="snp-impact-cols">
        <div class="snp-impact-col">
          <p class="snp-impact-col__title">긍정 요인</p>
          <table class="snp-factor-table">
            <tbody>
              {SNP_POSITIVE_FACTORS.map((row) => (
                <tr>
                  <td class="snp-factor-table__factor">{row.factor}</td>
                  <td>{row.interpretation}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="snp-impact-col">
          <p class="snp-impact-col__title">부정·중립 요인</p>
          <table class="snp-factor-table">
            <tbody>
              {SNP_NEGATIVE_FACTORS.map((row) => (
                <tr>
                  <td class="snp-factor-table__factor">{row.factor}</td>
                  <td>{row.interpretation}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ── 섹션 8: 성과급 영향 ────────────────────── -->
    <section class="content-section" aria-labelledby="bonus-title">
      <p class="snp-eyebrow">재직자 관점</p>
      <h2 id="bonus-title" class="snp-section-title">성과급에 영향이 있을까?</h2>
      <p class="snp-section-desc">이번 협력이 곧바로 SK하이닉스 성과급 상승을 의미하지는 않습니다. 다만 차세대 HBM 공급 확대가 실제 매출과 영업이익으로 이어질 경우 PS·PI 등 성과급 재원에는 중장기적으로 긍정적일 수 있습니다. 실제 성과급은 HBM 출하량뿐 아니라 메모리 가격, 전사 영업이익, 성과급 산정기준, 특별성과급 지급 여부 등에 따라 결정됩니다.</p>
      <p class="snp-section-desc snp-section-desc--tight">성과급 체크포인트:</p>
      <ul class="snp-check-list">
        {SNP_BONUS_CHECKPOINTS.map((item) => (
          <li class="snp-check-list__item">
            <span class="snp-check-list__icon">✓</span>
            {item}
          </li>
        ))}
      </ul>
      <div class="snp-cta-group">
        <a href="/reports/sk-hynix-bonus-2027/" class="snp-cta-btn snp-cta-btn--primary">
          SK하이닉스 2027 성과급 전망 (PS·PI 시나리오) →
        </a>
      </div>
    </section>

    <!-- ── 섹션 9: 삼성전자·마이크론 비교 ★ ───────── -->
    <section class="content-section" aria-labelledby="compare-title">
      <p class="snp-eyebrow">경쟁 구도</p>
      <h2 id="compare-title" class="snp-section-title">AI 메모리 경쟁구도 — 삼성전자·마이크론과 비교</h2>
      <div class="snp-role-table-wrap">
        <table class="snp-role-table">
          <thead>
            <tr><th>기업</th><th>협력 포인트</th><th>투자자가 볼 부분</th></tr>
          </thead>
          <tbody>
            {SNP_COMPARISON.map((row) => (
              <tr>
                <td>{row.company}</td>
                <td>{row.point}</td>
                <td>{row.investorView}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="snp-note">엔비디아 입장에서는 SK하이닉스 한 곳에만 의존하기보다 복수의 HBM 공급사를 확보하는 것이 공급망 안정성 측면에서 유리합니다. 따라서 장기 파트너십이 SK하이닉스의 독점 공급을 의미하지는 않습니다.</p>
    </section>

    <!-- ── 섹션 10: 2GW 수혜주 구조 ───────────────── -->
    <section class="content-section" aria-labelledby="chain-title">
      <p class="snp-eyebrow">밸류체인</p>
      <h2 id="chain-title" class="snp-section-title">2GW AI 팩토리, 계열사별 연계 영역</h2>
      <div class="snp-role-table-wrap">
        <table class="snp-role-table">
          <thead>
            <tr><th>구분</th><th>기업</th><th>예상 연계 영역</th><th>확정 여부</th></tr>
          </thead>
          <tbody>
            {SNP_VALUE_CHAIN.map((row) => (
              <tr>
                <td>{row.category}</td>
                <td>{row.company}</td>
                <td>{row.linkage}</td>
                <td><span class={`snp-confirm ${confirmClass(row.confirmed)}`}>{row.confirmed}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="snp-note">SK브로드밴드·SK이노베이션 계열·SK에코플랜트의 구체적인 참여는 공식 확정되지 않아 확정 역할이 아닌 잠재적 연계 영역으로 표시했습니다.</p>
    </section>

    <!-- ── 섹션 11: 진행 상황 업데이트 ────────────── -->
    <section class="content-section" aria-labelledby="progress-title">
      <p class="snp-eyebrow">진행 상황</p>
      <h2 id="progress-title" class="snp-section-title">진행 상황 체크리스트</h2>
      <div class="snp-role-table-wrap">
        <table class="snp-role-table">
          <thead>
            <tr><th>확인 항목</th><th>현재 상태</th><th>다음 확인 시점</th></tr>
          </thead>
          <tbody>
            {SNP_PROGRESS.map((row) => (
              <tr>
                <td>{row.item}</td>
                <td>{row.status}</td>
                <td>{row.nextCheck}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── 섹션 12: 리스크 ────────────────────────── -->
    <section class="content-section" aria-labelledby="risk-title">
      <p class="snp-eyebrow">리스크</p>
      <h2 id="risk-title" class="snp-section-title">주의해야 할 리스크</h2>
      <div class="snp-risk-list">
        {SNP_RISKS.map((r) => (
          <div class={`snp-risk-card ${riskClass(r.severity)}`}>
            <div>
              <p class="snp-risk-card__risk">{r.risk}</p>
              <p class="snp-risk-card__content">{r.content}</p>
            </div>
            <span class="snp-risk-card__severity">{r.severity}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- ── FAQ ─────────────────────────────────────── -->
    <section class="content-section" aria-labelledby="faq-title">
      <p class="snp-eyebrow">FAQ</p>
      <h2 id="faq-title" class="snp-section-title">자주 묻는 질문</h2>
      <div class="snp-faq">
        {SNP_FAQ.map((f) => (
          <details class="snp-faq__item">
            <summary class="snp-faq__q">{f.q}</summary>
            <p class="snp-faq__a">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <SeoContent
      introTitle="SK하이닉스 엔비디아 협력 핵심 정리"
      intro={[SNP_SEO_INTRO]}
      inputPoints={inputPoints}
      criteria={SNP_SEO_CRITERIA}
      faq={SNP_FAQ.map((f) => ({ question: f.q, answer: f.a }))}
      related={[
        { href: "/reports/sk-hynix-bonus-2027/", label: "SK하이닉스 2027 성과급 전망 (PS·PI 시나리오)" },
        { href: "/reports/semiconductor-value-chain/", label: "엔비디아는 왜 공장이 없을까? 반도체 산업 구조" },
        { href: "/reports/samsung-skhynix-800t-investment-comparison-2026/", label: "삼성전자·SK하이닉스 800조 투자 비교 리포트" },
        { href: "/reports/samsung-broadcom-partnership-2026/", label: "삼성전자 브로드컴 2,000억달러 협력 2026" },
        { href: "/reports/hbm4-vs-hbm5-beneficiary-comparison/", label: "HBM4 vs HBM5 수혜 비교" },
        { href: "/reports/ai-datacenter-infra-beneficiaries-2026/", label: "AI 데이터센터 전력·냉각 수혜 업종 2026" },
      ]}
    />

    <p class="snp-sources">
