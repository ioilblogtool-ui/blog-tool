---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import CalculatorHero from "../../components/CalculatorHero.astro";
import SeoContent from "../../components/SeoContent.astro";
import ToolActionBar from "../../components/ToolActionBar.astro";
import SimpleToolShell from "../../components/SimpleToolShell.astro";
import {
  FIC_CONFIG,
  FIC_CRITERIA,
  FIC_DEFAULT_INPUT,
  FIC_FAQ,
  FIC_GUIDES,
  FIC_INPUT_POINTS,
  FIC_META,
  FIC_PRESETS,
  FIC_RELATED,
  FIC_RULE_STATUS,
  FIC_SEO_INTRO,
  FIC_STATUS_LABELS,
} from "../../data/fourInsuranceCalculator";

const site = (import.meta.env.SITE ?? "https://bigyocalc.com").replace(/\/$/, "");
const normalizedBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${normalizedBase}${path.replace(/^\//, "")}`;
const d = FIC_DEFAULT_INPUT;

const applicabilityFields = [
  { key: "pension", label: "국민연금" },
  { key: "health", label: "건강보험·장기요양" },
  { key: "employment", label: "고용보험" },
] as const;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "4대보험 계산기 2027",
      applicationCategory: "FinanceApplication",
      operatingSystem: "All",
      inLanguage: "ko-KR",
      isAccessibleForFree: true,
      url: `${site}/tools/four-insurance-calculator/`,
      description: "월급과 보험별 산정 기준으로 2026·2027 근로자 4대보험 공제액을 항목별로 비교합니다.",
      dateModified: FIC_META.updatedAt,
      provider: { "@type": "Organization", name: "비교계산소" },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "홈", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "계산기", item: `${site}/tools/` },
        { "@type": "ListItem", position: 3, name: "4대보험 계산기 2027", item: `${site}/tools/four-insurance-calculator/` },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: FIC_FAQ.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<BaseLayout title={FIC_META.seoTitle} description={FIC_META.seoDescription} jsonLd={jsonLd} recordSessions={false} loadAds={false}>
  <SiteHeader />

  <SimpleToolShell calculatorId="four-insurance-calculator" pageClass="fic-page" resultFirst={true}>
    <Fragment slot="hero">
      <CalculatorHero eyebrow="급여 공제 계산" title={FIC_META.h1} description={FIC_META.description} />
      <section class="fic-status" aria-label="2027 요율 확정 상태">
        <p class="fic-status__title">2027 요율 상태 · {FIC_META.updatedAt} 확인</p>
        <ul class="fic-status__list">
          {FIC_RULE_STATUS.map((s) => (
            <li>
              <strong>{s.kind}</strong>
              <span class="fic-status__value">{s.value}</span>
              <span class={`fic-badge fic-badge--${s.status}`}>{FIC_STATUS_LABELS[s.status]}</span>
              <small>{s.text}</small>
            </li>
          ))}
        </ul>
      </section>
    </Fragment>

    <Fragment slot="actions">
      <ToolActionBar resetId="resetFicBtn" copyId="copyFicLinkBtn" />
    </Fragment>

    <Fragment slot="aside">
      <article class="panel">
        <div class="panel-heading">
          <div>
            <p class="panel-heading__eyebrow">입력</p>
            <h2 class="panel__title">월급 정보 입력</h2>
          </div>
          <p class="panel-heading__summary">입력한 값은 저장하거나 주소에 남기지 않습니다.</p>
        </div>

        <div class="fic-segment" role="group" aria-label="비교 방식">
          <button type="button" class="fic-segment__btn is-active" data-fic-compare="same_basis" aria-pressed="true">같은 월급으로 비교</button>
          <button type="button" class="fic-segment__btn" data-fic-compare="changed_pay" aria-pressed="false">급여 변화 포함</button>
        </div>

        <div class="fic-preset-grid">
          {FIC_PRESETS.map((preset, i) => (
            <button class="fic-preset-btn" type="button" data-fic-preset={i}>{preset.label}</button>
          ))}
        </div>

        <div class="form-grid form-grid--compact">
          <label class="field">
            <span>2026 기준월</span>
            <input id="ficBeforeMonth" type="month" min="2026-01" max="2026-12" value={d.beforeMonth} />
          </label>
          <label class="field">
            <span>2027 비교월</span>
            <input id="ficAfterMonth" type="month" min="2027-01" max="2027-12" value={d.afterMonth} />
          </label>

          <label class="field field-span-full">
            <span data-fic-salary-label>세전 월 급여 (원)</span>
            <input id="ficMonthlySalary" type="number" min="0" step="10000" inputmode="numeric" value={d.monthlySalary} />
            <small class="fic-error" data-fic-error="after_grossPayWon" aria-live="polite"></small>
          </label>
          <label class="field field-span-full">
            <span data-fic-taxfree-label>비과세 금액 (원)</span>
            <input id="ficTaxFreeAmount" type="number" min="0" step="10000" inputmode="numeric" value={d.taxFreeAmount} />
            <small>예: 식대 월 20만원. 보험료 기준만 줄이고 지급액에서 다시 빼지 않습니다.</small>
            <small class="fic-error" data-fic-error="after_nonTaxablePayWon" aria-live="polite"></small>
          </label>

          <div class="field-span-full fic-before-pay" data-fic-before-pay hidden>
            <label class="field">
              <span>2026 세전 월 급여 (원)</span>
              <input id="ficBeforeMonthlySalary" type="number" min="0" step="10000" inputmode="numeric" value={d.beforeMonthlySalary} />
              <small class="fic-error" data-fic-error="before_grossPayWon" aria-live="polite"></small>
            </label>
            <label class="field">
              <span>2026 비과세 금액 (원)</span>
              <input id="ficBeforeTaxFreeAmount" type="number" min="0" step="10000" inputmode="numeric" value={d.beforeTaxFreeAmount} />
              <small class="fic-error" data-fic-error="before_nonTaxablePayWon" aria-live="polite"></small>
            </label>
          </div>
        </div>
      </article>

      <article class="panel">
        <div class="panel-heading">
          <div>
            <p class="panel-heading__eyebrow">보험 적용</p>
            <h2 class="panel__title">어떤 보험이 적용되나요?</h2>
          </div>
          <p class="panel-heading__summary">'모름'은 0원으로 치지 않고 해당 항목을 계산하지 않습니다.</p>
        </div>
        <div class="form-grid form-grid--compact">
          {applicabilityFields.map((f) => (
            <label class="field">
              <span>{f.label}</span>
              <select data-fic-applies={f.key}>
                <option value="applies" selected>적용</option>
                <option value="not_applicable">미적용</option>
                <option value="unknown">모름</option>
              </select>
            </label>
          ))}
        </div>
        <p class="fic-help">장기요양보험은 건강보험 적용 여부를 따릅니다. 면제·경감 대상은 지원하지 않습니다.</p>

        <details class="fic-advanced" data-fic-advanced>
          <summary>고급: 보험별 산정 기준 직접 입력</summary>
          <label class="check-field">
            <input id="ficExplicitBases" type="checkbox" />
            <span>급여명세서의 보험별 기준 금액을 직접 입력</span>
          </label>
          <div class="form-grid form-grid--compact" data-fic-explicit-fields hidden>
            <label class="field">
              <span>국민연금 기준소득월액</span>
              <input id="ficBasisPension" type="number" min="0" step="1000" inputmode="numeric" />
              <small class="fic-error" data-fic-error="after_explicit_pension" aria-live="polite"></small>
            </label>
            <label class="field">
              <span>건강보험 보수월액</span>
              <input id="ficBasisHealth" type="number" min="0" step="1000" inputmode="numeric" />
              <small class="fic-error" data-fic-error="after_explicit_health" aria-live="polite"></small>
            </label>
            <label class="field">
              <span>고용보험 보수</span>
              <input id="ficBasisEmployment" type="number" min="0" step="1000" inputmode="numeric" />
              <small class="fic-error" data-fic-error="after_explicit_employment" aria-live="polite"></small>
            </label>
          </div>
          <p class="fic-help" data-fic-explicit-note>직접 입력한 기준은 2026·2027 양쪽에 같이 씁니다. 국민연금 기준소득월액은 천원 단위·상하한 안의 값만 받으며 자동으로 고치지 않습니다. 급여 변화 포함 비교에서는 쓸 수 없습니다.</p>
        </details>
      </article>

      <article class="panel">
        <div class="panel-heading">
          <div>
            <p class="panel-heading__eyebrow">가정·세금</p>
            <h2 class="panel__title">추가 옵션</h2>
          </div>
        </div>
        <label class="check-field">
          <input id="ficEmploymentScenario" type="checkbox" />
          <span>2027 고용보험 정부안(1.0%)을 가정해서 보기</span>
        </label>
        <p class="fic-help">켜면 '가정 합계'를 따로 보여줍니다. 확정 합계와 섞지 않습니다.</p>

        <div class="form-grid form-grid--compact">
          <label class="field field-span-full">
            <span>세금 반영</span>
            <select id="ficTaxMode">
              <option value="excluded" selected>세금 제외 (보험료 공제 후 금액)</option>
              <option value="manual">급여명세서 세금 직접 입력</option>
              <option value="legacy_preview">간이 추정 (참고용)</option>
            </select>
          </label>
          <div class="field-span-full fic-tax-fields" data-fic-tax="manual" hidden>
            <label class="field">
              <span>소득세 (원)</span>
              <input id="ficIncomeTax" type="number" min="0" step="10" inputmode="numeric" />
            </label>
            <label class="field">
              <span>지방소득세 (원)</span>
              <input id="ficLocalTax" type="number" min="0" step="10" inputmode="numeric" />
            </label>
            <small class="fic-help">두 기간에 같은 세금을 적용합니다.</small>
          </div>
          <div class="field-span-full fic-tax-fields" data-fic-tax="legacy_preview" hidden>
            <label class="field">
              <span>부양가족 수 (본인 포함)</span>
              <input id="ficDependents" type="number" min="1" max="11" step="1" value={d.dependents} />
            </label>
            <label class="field">
              <span>자녀 수 (간이 추정용)</span>
              <input id="ficChildren" type="number" min="0" max="8" step="1" value={d.children} />
            </label>
            <small class="fic-help">국세청 간이세액표가 아닌 연간 세율 단순 추정입니다. 실제 원천징수액과 다를 수 있습니다.</small>
          </div>
        </div>

        <label class="check-field">
          <input id="ficShowEmployerShare" type="checkbox" />
          <span>회사 부담 참고액 표시</span>
        </label>
      </article>
    </Fragment>

    <section class="content-section content-section--tight">
      <div class="section-header section-header--compact">
        <p class="section-header__eyebrow">핵심 결과</p>
        <h2>2027년 월급에서 빠지는 보험료</h2>
        <p id="ficModeCaption" class="fic-caption">같은 월급 기준 · 2026년 11월 vs 2027년 1월</p>
      </div>

      <div class="fic-form-error" id="ficFormError" role="alert" hidden></div>

      <div class="fic-kpi-grid" id="ficKpis">
        <article class="fic-kpi-card fic-kpi-card--main">
          <p id="ficAfterTotalLabel">2027 근로자 보험료</p>
          <strong id="ficAfterTotal">-</strong>
          <span id="ficAfterTotalNote">-</span>
        </article>
        <article class="fic-kpi-card">
          <p>2026년 대비 월 차이</p>
          <strong id="ficDelta">-</strong>
          <span id="ficDeltaNote">-</span>
        </article>
        <article class="fic-kpi-card">
          <p id="ficCashLabel">보험료 공제 후 금액</p>
          <strong id="ficCash">-</strong>
          <span id="ficCashNote">-</span>
        </article>
      </div>

      <div class="fic-scenario" id="ficScenario" hidden>
        <span class="fic-badge fic-badge--scenario">가정 적용</span>
        <p id="ficScenarioText"></p>
      </div>
    </section>

    <section class="content-section">
      <div class="section-header section-header--compact">
        <p class="section-header__eyebrow">항목별 비교</p>
        <h2>2026 · 2027 공제액</h2>
      </div>
      <div class="fic-table-wrap">
        <table class="fic-table fic-compare-table">
          <thead>
            <tr>
              <th scope="col">항목</th>
              <th scope="col">2026</th>
              <th scope="col">2027</th>
              <th scope="col">월 차이</th>
              <th scope="col">기준 상태</th>
            </tr>
          </thead>
          <tbody id="ficCompareBody"></tbody>
          <tfoot id="ficCompareFoot"></tfoot>
        </table>
      </div>
      <ul class="fic-notes" id="ficNotes"></ul>
    </section>

    <section class="content-section" id="ficEmployerSection" hidden>
      <div class="section-header section-header--compact">
        <p class="section-header__eyebrow">회사 부담</p>
        <h2>지원 항목의 회사 부담 참고액</h2>
        <p class="fic-caption">국민연금·건강보험·장기요양 회사분과 고용보험 실업급여 회사분만 더했습니다. 고용안정·직업능력개발 사업분과 산재보험은 포함하지 않습니다.</p>
      </div>
      <div class="fic-table-wrap">
        <table class="fic-table">
          <thead><tr><th scope="col">항목</th><th scope="col">2026 회사분</th><th scope="col">2027 회사분</th></tr></thead>
          <tbody id="ficEmployerBody"></tbody>
        </table>
      </div>
    </section>

    <section class="content-section">
      <div class="section-header section-header--compact">
        <p class="section-header__eyebrow">공제 후 금액</p>
        <h2>세금 반영 범위</h2>
      </div>
      <div class="fic-table-wrap">
        <table class="fic-table">
          <thead><tr><th scope="col">구분</th><th scope="col">2026</th><th scope="col">2027</th></tr></thead>
          <tbody id="ficCashBody"></tbody>
        </table>
      </div>
    </section>

    <section class="content-section">
      <div class="section-header section-header--compact">
        <p class="section-header__eyebrow">해석 가이드</p>
        <h2>보험료 항목별 기준</h2>
      </div>
      <div class="fic-guide-grid">
        {FIC_GUIDES.map((item) => (
          <article class="fic-guide-card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section fic-report-cta">
      <div>
        <p class="fic-eyebrow">요율표와 함께 보기</p>
        <h2>2026 직장인 세금·4대보험 요율표</h2>
        <p>2026년 요율과 급여명세서 예시는 요율표 리포트에서 확인할 수 있습니다.</p>
      </div>
      <a class="button button--secondary" href={withBase("/reports/employee-tax-insurance-rates-2026/")}>요율표 리포트 보기</a>
    </section>

    <Fragment slot="seo">
      <SeoContent
        introTitle="4대보험 계산기 2027 사용법과 계산 기준"
        intro={FIC_SEO_INTRO}
        inputPoints={FIC_INPUT_POINTS}
        criteria={FIC_CRITERIA}
        faq={FIC_FAQ}
        related={FIC_RELATED}
      />
    </Fragment>
  </SimpleToolShell>

  <script id="ficConfig" type="application/json" set:html={JSON.stringify(FIC_CONFIG)} />
  <script type="module" src={withBase("/scripts/four-insurance-calculator.js?v=20261110")}></script>
</BaseLayout>
