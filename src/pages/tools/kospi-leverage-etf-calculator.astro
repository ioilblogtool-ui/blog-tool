---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import CalculatorHero from "../../components/CalculatorHero.astro";
import InfoNotice from "../../components/InfoNotice.astro";
import SeoContent from "../../components/SeoContent.astro";
import ToolActionBar from "../../components/ToolActionBar.astro";
import SimpleToolShell from "../../components/SimpleToolShell.astro";
import {
  KLC_META,
  KLC_SCENARIOS,
  KLC_PRINCIPAL_PRESETS,
  KLC_DETAIL_CARDS,
  KLC_MECHANISM,
  KLC_REGULATION_TIMELINE,
  KLC_FAQ,
  KLC_RELATED_LINKS,
  KLC_SOURCE_LINKS,
  KLC_SCENARIO_ORDER,
  KLC_PATH_DEFAULTS,
  KLC_PATH_LIMITS,
  KLC_PATH_PRESETS,
  KLC_RECOVERY_DROPS,
  KLC_RECOVERY_SPLITS,
  KLC_MECHANISM_CRASH,
  KLC_CRASH_REPORT_LINK,
} from "../../data/kospiLeverageEtfCalculator";
import { buildRecoveryRows } from "../../utils/kospiLeverageEtfCalculator";

const normalizedBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${normalizedBase}${path.replace(/^\//, "")}`;

const defaultScenario = KLC_SCENARIOS[0];
const orderedScenarios = KLC_SCENARIO_ORDER.map((id) => KLC_SCENARIOS.find((s) => s.id === id)).filter(
  (s): s is (typeof KLC_SCENARIOS)[number] => Boolean(s),
);
const config = {
  SCENARIOS: KLC_SCENARIOS,
  DEFAULT_SCENARIO_ID: defaultScenario.id,
  PATH_DEFAULTS: KLC_PATH_DEFAULTS,
  PATH_LIMITS: KLC_PATH_LIMITS,
};

const recoveryRows = buildRecoveryRows(KLC_RECOVERY_DROPS, KLC_RECOVERY_SPLITS, 2);
const pct = (v: number | null) =>
  v === null ? "—" : `${v > 0 ? "+" : v < 0 ? "−" : ""}${Math.abs(v * 100).toFixed(2)}%`;
const plainIndexRecovery = KLC_RECOVERY_DROPS.map((d) => `−${d}% → ${pct(d / (100 - d))}`).join(", ");

// 신규 리포트는 페이지 파일이 생긴 뒤에만 링크한다.
const hasCrashReport = Object.keys(import.meta.glob("../reports/kospi-october-crash-2026.astro")).length > 0;
const relatedLinks = hasCrashReport ? [KLC_CRASH_REPORT_LINK, ...KLC_RELATED_LINKS] : KLC_RELATED_LINKS;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: KLC_META.title,
      applicationCategory: "FinanceApplication",
      operatingSystem: "Web",
      inLanguage: "ko-KR",
      url: `https://bigyocalc.com/tools/${KLC_META.slug}/`,
      description: KLC_META.seoDescription,
      dateModified: KLC_META.updatedAt,
      publisher: {
        "@type": "Organization",
        name: "비교계산소",
        url: "https://bigyocalc.com",
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: KLC_FAQ.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "홈", item: "https://bigyocalc.com/" },
        { "@type": "ListItem", position: 2, name: "계산기", item: "https://bigyocalc.com/tools/" },
        { "@type": "ListItem", position: 3, name: KLC_META.title, item: `https://bigyocalc.com/tools/${KLC_META.slug}/` },
      ],
    },
  ],
};
---

<BaseLayout
  title={KLC_META.seoTitle}
  description={KLC_META.seoDescription}
  ogImage="/og/tools/kospi-leverage-etf-calculator.png"
  jsonLd={jsonLd}
>
  <SiteHeader />

  <SimpleToolShell calculatorId="kospi-leverage-etf" pageClass="klc-page" resultFirst={true}>
    <Fragment slot="hero">
      <CalculatorHero
        eyebrow={KLC_META.eyebrow}
        title={KLC_META.h1}
        description={KLC_META.description}
      />
    </Fragment>

    <Fragment slot="actions">
      <ToolActionBar resetId="klcResetBtn" copyId="klcCopyLinkBtn" />
    </Fragment>

    <Fragment slot="aside">
      <div class="stack" id="klc-inputs">
        <article class="panel klc-input-panel">
          <div class="panel-heading">
            <div>
              <p class="panel-heading__eyebrow">① 투자금액 · ② 시장 흐름</p>
              <h2 class="panel__title">투자 조건 입력</h2>
            </div>
          </div>

          <label class="field klc-field-wide">
            <span>투자금액</span>
            <div class="klc-money-field">
              <input id="klc-principal" type="number" inputmode="decimal" value="1000" min="0" step="1" />
              <span class="klc-money-unit">만원</span>
            </div>
          </label>
          <div class="klc-preset-row" aria-label="빠른 금액 선택">
            {KLC_PRINCIPAL_PRESETS.map((preset) => (
              <button type="button" class="klc-preset-chip" data-principal-preset={preset.won}>
                {preset.label}
              </button>
            ))}
          </div>

          <div class="klc-scenario-grid" aria-label="시장 흐름 시나리오">
            {orderedScenarios.map((scenario) => (
              <button
                type="button"
                class="klc-scenario-card"
                data-scenario-id={scenario.id}
                aria-pressed={scenario.id === defaultScenario.id ? "true" : "false"}
              >
                <strong>{scenario.label}</strong>
                <small>{scenario.narrative}</small>
              </button>
            ))}
          </div>

          <div class="klc-path-panel" data-klc-path-panel hidden>
            <div data-klc-builder="crashRebound">
              <p class="klc-path-panel__title">하락·반등 조건</p>
              <div class="klc-preset-row" aria-label="급락·반등 빠른 선택">
                {KLC_PATH_PRESETS.map((preset) => (
                  <button type="button" class="klc-preset-chip" data-klc-path-preset
                    data-drop={preset.dropPct} data-days={preset.days}>{preset.label}</button>
                ))}
              </div>
              <div class="klc-path-grid">
                <label class="field">
                  <span>코스피200 하락률(%)</span>
                  <input id="klc-drop" type="number" inputmode="decimal" min={KLC_PATH_LIMITS.dropPct[0]}
                    max={KLC_PATH_LIMITS.dropPct[1]} step="1" value={KLC_PATH_DEFAULTS.dropPct} />
                </label>
                <label class="field">
                  <span>하락 기간(거래일)</span>
                  <input id="klc-drop-days" type="number" inputmode="numeric" min={KLC_PATH_LIMITS.days[0]}
                    max={KLC_PATH_LIMITS.days[1]} step="1" value={KLC_PATH_DEFAULTS.dropDays} />
                </label>
              </div>
              <fieldset class="klc-rebound-mode">
                <legend>반등 방식</legend>
                <label><input type="radio" name="klc-rebound-mode" value="auto" checked /> 원점까지 회복</label>
                <label><input type="radio" name="klc-rebound-mode" value="manual" /> 반등률 직접 입력</label>
              </fieldset>
              <div class="klc-path-grid">
                <label class="field">
                  <span>코스피200 반등률(%)</span>
                  <input id="klc-rebound" type="number" inputmode="decimal" min={KLC_PATH_LIMITS.reboundPct[0]}
                    max={KLC_PATH_LIMITS.reboundPct[1]} step="0.1" value={KLC_PATH_DEFAULTS.reboundPct} disabled />
                  <small data-result="autoReboundHint">원점 회복에 필요한 +25.00%가 자동 적용됩니다.</small>
                </label>
                <label class="field">
                  <span>반등 기간(거래일)</span>
                  <input id="klc-rebound-days" type="number" inputmode="numeric" min={KLC_PATH_LIMITS.days[0]}
                    max={KLC_PATH_LIMITS.days[1]} step="1" value={KLC_PATH_DEFAULTS.reboundDays} />
                </label>
              </div>
            </div>
            <div data-klc-builder="alternating">
              <p class="klc-path-panel__title">오르내림 조건</p>
              <div class="klc-path-grid">
                <label class="field">
                  <span>하루 등락 폭(%)</span>
                  <input id="klc-alt-amp" type="number" inputmode="decimal" min={KLC_PATH_LIMITS.altAmpPct[0]}
                    max={KLC_PATH_LIMITS.altAmpPct[1]} step="1" value={KLC_PATH_DEFAULTS.altAmpPct} />
                </label>
                <label class="field">
                  <span>반복 횟수(오름+내림 1회)</span>
                  <input id="klc-alt-cycles" type="number" inputmode="numeric" min={KLC_PATH_LIMITS.altCycles[0]}
                    max={KLC_PATH_LIMITS.altCycles[1]} step="1" value={KLC_PATH_DEFAULTS.altCycles} />
                </label>
              </div>
            </div>
          </div>

          <p class="klc-multiple-static">③ 상품 배율: <strong>2배 레버리지</strong> (국내 표준)</p>

          <details class="klc-advanced">
            <summary>고급 설정</summary>
            <label class="field">
              <span>배율 직접 입력</span>
              <input id="klc-multiple" type="number" inputmode="decimal" value="2" min="1" max="5" step="0.5" />
              <small>3배 등 다른 배율을 참고용으로 계산해볼 수 있습니다.</small>
            </label>
            <label class="field">
              <span>연 운용보수(%)</span>
              <input id="klc-fee-rate" type="number" inputmode="decimal" value="0.64" min="0" step="0.01" />
              <small>
                기본값은 삼성자산운용 KODEX 레버리지 총보수 공시 기준(연 0.64%)이며, 상품마다 다를 수 있습니다.
                입력한 보수율만 단순 일할 계산한 값이며, 기타비용·거래비용·선물 관련 비용·추적오차는 포함되지 않습니다.
              </small>
            </label>
          </details>
        </article>

        <InfoNotice
          title="데이터 기준 안내"
          lines={[
            "이 계산기는 선택한 시장 흐름의 일별 등락률을 그대로 복리 계산한 참고용 시뮬레이션입니다. 실제 ETF 종가·순자산가치(NAV)를 사용한 백테스트가 아닙니다.",
            "실제 상품 수익률에는 운용보수 외에도 선물 롤오버 비용, 추적오차, NAV와 시장가격 간 괴리, 거래·세금 비용이 추가로 반영됩니다.",
            "투자 권유가 아니며, 실제 투자 판단에는 상품 투자설명서를 확인해야 합니다.",
          ]}
        />
      </div>
    </Fragment>

    <article class="panel result-priority-panel klc-result-panel" id="klc-results" aria-live="polite">
      <div class="panel-heading">
        <div>
          <p class="panel-heading__eyebrow">계산 결과</p>
          <h2 class="panel__title">내 예상 손익</h2>
        </div>
      </div>

      <div class="klc-hero-grid">
        <div class="klc-hero-main">
          <span class="klc-hero-label">내 예상 평가금액</span>
          <strong class="klc-hero-amount" data-result="finalAmount">-</strong>
          <p class="klc-hero-profit" data-result="profitAmount">-</p>
        </div>
        <div class="klc-hero-compare">
          <span class="klc-hero-label">코스피200에 일반 투자했다면</span>
          <strong class="klc-hero-compare-amount" data-result="indexOnlyFinalAmount">-</strong>
        </div>
      </div>

      <p class="klc-compare-sentence" data-result="compareSentence">투자금액을 입력하면 계산합니다.</p>
      <p class="klc-recovery-note" data-result="recoveryNote" hidden></p>
      <p class="klc-recovery-note klc-recovery-note--index" data-result="indexRecoveryNote" hidden></p>
      <p class="klc-warning" data-result="wipeoutWarning" hidden>
        하루 변동이 커서 2배 레버리지 가치가 0이 되는 구간입니다. 실제 상품은 거래소 조치 등으로 다르게 움직일 수 있어 결과를 표시하지 않습니다.
      </p>

      <details class="klc-detail-toggle">
        <summary>자세히 보기</summary>
        <div class="klc-detail-grid">
          {KLC_DETAIL_CARDS.map((card) => (
            <article class="klc-detail-card" data-card={card.key}>
              <div class="klc-detail-card__top">
                <p class="klc-detail-label">{card.label}</p>
                <span>{card.badge}</span>
              </div>
              <strong class="klc-detail-value" data-result={card.key}>-</strong>
              <p>{card.description}</p>
            </article>
          ))}
        </div>
        <p class="klc-detail-reason" data-result="detailReason"></p>
      </details>
    </article>

    <section class="content-section klc-recovery">
      <div class="section-header section-header--compact">
        <p class="section-header__eyebrow">원금 회복 비교 · 시뮬레이션</p>
        <h2>같은 하락이라도 레버리지는 회복이 훨씬 어렵습니다</h2>
      </div>
      <div class="table-wrap klc-table-wrap">
        <table class="klc-mechanism-table klc-recovery__table">
          <caption>2배 레버리지·운용보수 0% 기준 시뮬레이션 (원금 1 기준)</caption>
          <thead>
            <tr>
              <th scope="col">코스피200 하락</th>
              <th scope="col">하락 기간</th>
              <th scope="col">레버리지 가치</th>
              <th scope="col">레버리지 회복 필요</th>
              <th scope="col">코스피200 회복 필요</th>
            </tr>
          </thead>
          <tbody>
            {recoveryRows.map((row) => (
              <tr data-group={row.dropPct}>
                <td data-label="코스피200 하락">−{row.dropPct}%</td>
                <td data-label="하락 기간">{row.days === 1 ? "하루" : `${row.days}거래일 분할`}</td>
                <td data-label="레버리지 가치">{row.leverageValue.toFixed(4)}</td>
                <td data-label="레버리지 회복 필요">{pct(row.etfRecoveryNeeded)}</td>
                <td data-label="코스피200 회복 필요">{pct(row.indexRecoveryNeeded)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="klc-path-note">
        코스피200 회복 필요 상승률은 하락과 같은 기간에 걸쳐 고르게 반등한다고 가정한 값입니다. 일반 코스피200 투자는 {plainIndexRecovery}만 오르면 원금이 됩니다.
      </p>
      <a class="klc-inline-link" href={withBase("/tools/stock-loss-recovery-calculator/")}>일반 주식 손실 복구율 계산하기 →</a>
    </section>

    <section class="content-section klc-path-section">
      <div class="section-header section-header--compact">
        <p class="section-header__eyebrow">경로 시각화</p>
        <h2>일별 등락 경로로 보는 괴리</h2>
      </div>
      <div class="table-wrap klc-table-wrap">
        <table class="klc-mechanism-table">
          <thead>
            <tr><th>날짜</th><th>코스피200</th><th><span data-result="multipleLabelHint">2배</span> 레버리지</th></tr>
          </thead>
          <tbody data-klc-path-body></tbody>
        </table>
      </div>
      <button type="button" class="klc-path-toggle" data-klc-path-toggle hidden>전체 보기</button>
      <p class="klc-path-note">중간에는 레버리지 수익률이 더 높거나 낮았더라도, 상승과 하락이 반복되면 최종 결과는 단순 계산과 달라질 수 있습니다.</p>
    </section>

    <section class="content-section klc-mechanism-section">
      <div class="section-header section-header--compact">
        <p class="section-header__eyebrow">왜 이런 일이 벌어질까</p>
        <h2>{KLC_MECHANISM.title}</h2>
      </div>
      <div class="table-wrap klc-table-wrap">
        <table class="klc-mechanism-table">
          <thead>
            <tr><th>구분</th><th>시작</th><th>1일차</th><th>2일차</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>코스피200</td>
              <td>{KLC_MECHANISM.steps[0].indexValue}</td>
              <td>{KLC_MECHANISM.steps[1].indexValue} ({KLC_MECHANISM.steps[1].indexReturnLabel})</td>
              <td>{KLC_MECHANISM.steps[2].indexValue} ({KLC_MECHANISM.steps[2].indexReturnLabel})</td>
            </tr>
            <tr>
              <td>2배 레버리지</td>
              <td>{KLC_MECHANISM.steps[0].leverageValue}</td>
              <td>{KLC_MECHANISM.steps[1].leverageValue} ({KLC_MECHANISM.steps[1].leverageReturnLabel})</td>
              <td>{KLC_MECHANISM.steps[2].leverageValue} ({KLC_MECHANISM.steps[2].leverageReturnLabel})</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="klc-mechanism-conclusion">{KLC_MECHANISM.conclusion}</p>

      <h3 class="klc-subheading">{KLC_MECHANISM_CRASH.title}</h3>
      <div class="table-wrap klc-table-wrap">
        <table class="klc-mechanism-table">
          <thead>
            <tr>{["구분", ...KLC_MECHANISM_CRASH.steps.map((step) => step.day)].map((label) => <th>{label}</th>)}</tr>
          </thead>
          <tbody>
            <tr>
              <td>코스피200</td>
              {KLC_MECHANISM_CRASH.steps.map((step) => (
                <td>{step.indexValue}{step.indexReturnLabel !== "-" && ` (${step.indexReturnLabel})`}</td>
              ))}
            </tr>
            <tr>
              <td>2배 레버리지</td>
              {KLC_MECHANISM_CRASH.steps.map((step) => (
                <td>{step.leverageValue}{step.leverageReturnLabel !== "-" && ` (${step.leverageReturnLabel})`}</td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>
      <p class="klc-mechanism-conclusion">{KLC_MECHANISM_CRASH.conclusion}</p>
    </section>

    <section class="content-section klc-regulation-section">
      <div class="section-header section-header--compact">
        <p class="section-header__eyebrow">참고</p>
        <h2>2026년 레버리지 규제, KODEX 레버리지도 해당될까?</h2>
      </div>
      <p class="klc-regulation-answer">
        <strong>아닙니다.</strong> 2026년 7월 31일부터 시행된 3천만원 기본예탁금 기준(8월 19일부터 현금만 인정)은 삼성전자·SK하이닉스처럼 개별 종목을 추종하는 <strong>단일종목 레버리지 ETF·ETN</strong>에 적용됩니다. 코스피200 지수를 추종하는 KODEX 레버리지 같은 일반 지수형 레버리지 ETF는 이번 단일종목 규제 대상이 아닙니다.
      </p>
      <ul class="klc-regulation-list">
        {KLC_REGULATION_TIMELINE.map((event) => (
          <li class="klc-regulation-item" data-status={event.status}>
            <strong>{event.dateLabel}</strong>
            <span>{event.content}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="content-section klc-source-section">
      <div class="section-header section-header--compact">
        <p class="section-header__eyebrow">출처</p>
        <h2>기본값에 참고한 공개 자료</h2>
      </div>
      <p class="klc-source-note">최종 업데이트: 2026년 10월 27일 · 규제 시행일은 금융위원회 발표와 이후 보도 기준</p>
      <div class="klc-source-list">
        {KLC_SOURCE_LINKS.map((source) => (
          <a href={source.href} target="_blank" rel="noreferrer">{source.label}</a>
        ))}
      </div>
    </section>

    <Fragment slot="seo">
      <SeoContent
        introTitle="코스피 레버리지 ETF는 왜 정확히 2배가 아닐까요?"
        intro={[
          "레버리지 ETF는 코스피200의 전체 투자기간 수익률을 2배로 만드는 상품이 아닙니다. 코스피200의 하루 수익률을 매일 2배로 추종하도록 설계된 상품입니다. 하루 동안 코스피200이 5% 상승하면 2배 레버리지는 약 10% 상승을 목표로 합니다.",
