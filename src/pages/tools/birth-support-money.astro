---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import CalculatorHero from "../../components/CalculatorHero.astro";
import InfoNotice from "../../components/InfoNotice.astro";
import SeoContent from "../../components/SeoContent.astro";
import ToolActionBar from "../../components/ToolActionBar.astro";
import TimelineToolShell from "../../components/TimelineToolShell.astro";
import {
  BSM_CONFIG,
  BSM_CRITERIA,
  BSM_FAQ,
  BSM_INPUT_POINTS,
  BSM_INTRO,
  BSM_LOCAL_OPTIONS,
  BSM_LOCAL_RULES,
  BSM_META,
  BSM_NOTICE_LINES,
  BSM_PENDING_CHECKS,
  BSM_REFERENCE_LINKS,
  BSM_RELATED_LINKS,
  BSM_SCENARIOS,
  BSM_TIER_OPTIONS,
} from "../../data/birthSupportMoney";

const normalizedBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${normalizedBase}${path.replace(/^\//, "")}`;

const config = {
  config: BSM_CONFIG,
  localRules: BSM_LOCAL_RULES,
};

const badgeClass: Record<string, string> = {
  공식: "bsm-badge--official",
  참고: "bsm-badge--reference",
  시뮬레이션: "bsm-badge--simulation",
  추정: "bsm-badge--estimate",
};

const toMan = (won: number) => `${new Intl.NumberFormat("ko-KR").format(won / 10000)}만원`;

const faqSchema = BSM_FAQ.map((item) => ({
  "@type": "Question",
  name: item.question,
  acceptedAnswer: { "@type": "Answer", text: item.answer },
}));
---

<BaseLayout
  title={BSM_META.title}
  description={BSM_META.description}
  ogImage="/og/tools/birth-support-total.png"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: BSM_META.h1,
    applicationCategory: "FinanceApplication",
    operatingSystem: "All",
    description: BSM_META.description,
    url: `${(import.meta.env.SITE ?? "https://bigyocalc.com").replace(/\/$/, "")}/tools/birth-support-money/`,
    offers: { "@type": "Offer", price: "0", priceCurrency: "KRW" },
    mainEntity: { "@type": "FAQPage", mainEntity: faqSchema },
  }}
>
  <SiteHeader />

  <TimelineToolShell calculatorId="birth-support-money" pageClass="birth-support-money-page">
    <Fragment slot="hero">
      <CalculatorHero eyebrow="2027 출산지원금" title={BSM_META.h1} description={BSM_META.heroDescription} />
    </Fragment>

    <Fragment slot="actions">
      <ToolActionBar resetId="bsm-reset-btn" copyId="bsm-copy-link-btn" />
      <p class="bsm-share-note">공유 링크에는 입력한 출생일이 포함됩니다.</p>
    </Fragment>

    <Fragment slot="aside">
      <article class="panel bsm-input-panel">
        <div class="panel-heading">
          <div>
            <p class="panel-heading__eyebrow">입력</p>
            <h2 class="panel__title">출생 조건 입력</h2>
          </div>
          <p class="panel-heading__summary">입력하는 즉시 결과가 바뀝니다. 출생일 기준으로 적용 예정 제도를 자동 구분합니다.</p>
        </div>

        <div class="form-grid bsm-input-grid">
          <label class="field">
            <span>출생일 또는 출산예정일</span>
            <input
              id="bsm-birth-date"
              type="date"
              min={BSM_CONFIG.birthDateRange.min}
              max={BSM_CONFIG.birthDateRange.max}
              aria-describedby="bsm-input-error"
            />
            <small>2026년 1월 1일 ~ 2028년 12월 31일 사이 날짜를 입력하세요.</small>
          </label>

          <label class="field">
            <span>출생순위</span>
            <select id="bsm-birth-order" class="select">
              <option value="1">첫째</option>
              <option value="2">둘째</option>
              <option value="3">셋째 이상</option>
            </select>
          </label>

          <label class="field">
            <span>거주 지역 유형</span>
            <select id="bsm-region-tier" class="select">
              {BSM_TIER_OPTIONS.map((item) => <option value={item.value}>{item.label}</option>)}
            </select>
            <small>현행 아동수당 금액(월 10만~12만원)에 쓰입니다.</small>
          </label>

          <label class="field">
            <span>2027 개편안 우대지역</span>
            <select id="bsm-preferred" class="select">
              <option value="no">아니오</option>
              <option value="yes">예</option>
              <option value="unknown">모름</option>
            </select>
            <small id="bsm-preferred-help">행정안전부 지방우대지수 기준 우대지역 명단은 아직 공개되지 않았습니다. 모르면 ‘모름’을 선택하세요.</small>
          </label>

          <label class="field">
            <span>양육 방식</span>
            <select id="bsm-care-mode" class="select">
              <option value="home">가정보육</option>
              <option value="daycare">어린이집 이용</option>
              <option value="switch12">12개월부터 어린이집</option>
            </select>
          </label>

          <label class="field">
            <span>타임라인 기간</span>
            <select id="bsm-period" class="select">
              <option value="12">첫 1년 (12개월)</option>
              <option value="24" selected>두 돌까지 (24개월)</option>
              <option value="156">장기 참고 (만 13세 미만)</option>
            </select>
          </label>

          <label class="field">
            <span>지자체 지원 지역 (선택)</span>
            <select id="bsm-local-region" class="select">
              {BSM_LOCAL_OPTIONS.map((item) => <option value={item.value}>{item.label}</option>)}
            </select>
            <small>지자체 지원은 중앙정부 예상액과 따로 표시합니다.</small>
          </label>
        </div>
        <p class="bsm-input-footnote">쌍둥이 이상은 아이마다 지원이 계산되며 출생순위 산정 기준은 확인이 필요합니다. 이 계산기는 아이 1명 기준입니다.</p>
      </article>
    </Fragment>

    <section id="bsm-system-banner" class="bsm-system-banner" data-system="none" hidden>
      <p class="bsm-system-banner__label" id="bsm-system-label"></p>
      <h2 class="bsm-system-banner__title" id="bsm-system-title"></h2>
      <p class="bsm-system-banner__desc" id="bsm-system-desc"></p>
    </section>

    <p id="bsm-empty-state" class="bsm-empty-state">출생일 또는 출산예정일을 입력하면 적용 예정 제도와 예상 지원금이 표시됩니다. 아래 ‘조건별 예상 지원금 예시’ 표도 함께 확인하세요.</p>
    <p id="bsm-input-error" class="bsm-input-error" role="alert" hidden></p>
    <p id="bsm-url-notice" class="bsm-url-notice" hidden></p>

    <div id="bsm-result" hidden>
      <section class="metrics metrics--four bsm-kpis" aria-label="예상 지원금 요약">
        <article class="metric-card summary-card">
          <p>출생 직후 지원금 <span id="bsm-r-birth-support-badge" class="bsm-badge bsm-badge--small"></span></p>
          <strong id="bsm-r-birth-support">-</strong>
          <small id="bsm-r-birth-support-sub" class="bsm-kpi-sub"></small>
        </article>
        <article class="metric-card summary-card">
          <p>월별 양육지원금 <span id="bsm-r-monthly-badge" class="bsm-badge bsm-badge--small"></span></p>
          <strong id="bsm-r-monthly">-</strong>
          <small id="bsm-r-monthly-sub" class="bsm-kpi-sub"></small>
        </article>
        <article class="metric-card summary-card bsm-kpi--primary">
          <p>첫 1년 예상 총지원금 <span id="bsm-r-12m-badge" class="bsm-badge bsm-badge--small"></span></p>
          <strong id="bsm-r-12m">-</strong>
          <small class="bsm-kpi-sub">출생~11개월</small>
        </article>
        <article class="metric-card summary-card">
          <p>두 돌까지 예상 총지원금 <span id="bsm-r-24m-badge" class="bsm-badge bsm-badge--small"></span></p>
          <strong id="bsm-r-24m">-</strong>
          <small class="bsm-kpi-sub">출생~23개월</small>
        </article>
      </section>
      <p id="bsm-r-preferred-hint" class="bsm-preferred-hint" hidden></p>
      <p id="bsm-result-note" class="bsm-result-note" aria-live="polite"></p>

      <article id="bsm-long-panel" class="panel bsm-long-panel" hidden>
        <div class="panel-heading">
          <div>
            <p class="panel-heading__eyebrow">장기 참고</p>
            <h2 class="panel__title">만 13세 미만까지 누적 예상</h2>
          </div>
        </div>
        <p class="bsm-long-value"><strong id="bsm-r-long">-</strong> <span class="bsm-badge bsm-badge--estimate">추정</span></p>
        <p class="bsm-muted">현재 발표된 금액이 13세 미만까지 그대로 유지된다고 가정한 값입니다. 제도 변경 가능성이 커서 참고로만 보세요.</p>
      </article>

      <article class="panel">
        <div class="panel-heading">
          <div>
            <p class="panel-heading__eyebrow">항목별 분해</p>
            <h2 class="panel__title">어떤 지원이 합계를 만드는지 봅니다</h2>
          </div>
          <p class="panel-heading__summary" id="bsm-breakdown-note">-</p>
        </div>
        <div id="bsm-breakdown" class="bsm-breakdown-grid"></div>
      </article>

      <div class="bsm-compare-grid">
        <article id="bsm-compare-system" class="panel bsm-compare-card">
          <div class="panel-heading">
            <div>
              <p class="panel-heading__eyebrow">제도 비교</p>
              <h2 class="panel__title">6월 30일 출생과 7월 1일 출생 비교</h2>
            </div>
          </div>
          <div id="bsm-compare-system-body"></div>
          <p class="bsm-muted">출산 시기는 건강과 의료 판단이 우선입니다. 이 비교는 제도 차이를 이해하기 위한 참고용입니다.</p>
        </article>

        <article id="bsm-compare-preferred" class="panel bsm-compare-card" hidden>
          <div class="panel-heading">
            <div>
              <p class="panel-heading__eyebrow">지역 비교</p>
              <h2 class="panel__title">일반지역과 우대지역 차이</h2>
            </div>
          </div>
          <div id="bsm-compare-preferred-body"></div>
          <p class="bsm-muted">우대지역 명단이 공개되면 거주지가 해당하는지 확인하세요.</p>
        </article>
      </div>
    </div>

    <InfoNotice title="계산 전 확인할 점" lines={BSM_NOTICE_LINES} />

    <Fragment slot="timeline">
      <article id="bsm-timeline-panel" class="panel" hidden>
        <div class="panel-heading">
          <div>
            <p class="panel-heading__eyebrow">월별 타임라인</p>
            <h2 class="panel__title">월별 예상 지원 흐름</h2>
          </div>
          <p class="panel-heading__summary" id="bsm-timeline-note">일시금과 매월 지급분을 나눠 봅니다.</p>
        </div>
        <div class="bsm-timeline-chart-wrap" id="bsm-timeline-chart-wrap">
          <canvas id="bsm-timeline-chart" aria-label="월별 예상 지원금 막대 차트" role="img"></canvas>
        </div>
        <div class="table-wrap">
          <table class="result-table">
            <thead id="bsm-timeline-head"></thead>
            <tbody id="bsm-timeline-table-body"></tbody>
          </table>
        </div>
      </article>

      <section class="bsm-section" id="bsm-local-panel">
        <div class="bsm-section__head">
          <p class="bsm-section__eyebrow">지자체 추가 지원</p>
          <h2>지자체 출산지원금은 따로 확인하세요</h2>
        </div>
        <div class="bsm-local-card">
          <p id="bsm-local-note">지자체 출산지원금은 지역마다 금액·거주요건·신청기한이 달라 중앙정부 예상액과 따로 확인하세요.</p>
          <a href={withBase("/reports/birth-support-by-region-2026/")}>2026 지역별 출산지원금 비교 보기</a>
        </div>
      </section>

      <section class="bsm-section">
        <div class="bsm-section__head">
          <p class="bsm-section__eyebrow">대표 시나리오</p>
          <h2>조건별 예상 지원금 예시</h2>
        </div>
        <p class="bsm-muted">아래 금액은 예시 조건의 예상치입니다(현금성 지원 기준, 지자체 지원 제외). 일반지역 시나리오의 현행 아동수당은 수도권 금액으로 계산했습니다.</p>
        <div class="table-wrap">
          <table class="result-table bsm-scenario-table">
            <thead>
              <tr>
                <th scope="col">조건</th>
                <th scope="col">적용 예정 제도</th>
                <th scope="col">출생 직후</th>
                <th scope="col">첫 1년</th>
                <th scope="col">두 돌까지</th>
                <th scope="col">구분</th>
              </tr>
            </thead>
            <tbody>
              {BSM_SCENARIOS.map((item) => (
                <tr>
                  <td>{item.label}</td>
                  <td>{item.system === "current" ? "현행" : "개편안(예정)"}</td>
                  <td>{toMan(item.birthSupport)}</td>
                  <td>{toMan(item.total12)}</td>
                  <td>{toMan(item.total24)}</td>
                  <td><span class={`bsm-badge bsm-badge--small ${badgeClass[item.badge]}`}>{item.badge}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="bsm-section">
        <div class="bsm-section__head">
          <p class="bsm-section__eyebrow">재확인 항목</p>
          <h2>확정 전 확인할 사항</h2>
        </div>
        <ol class="bsm-pending-list">
          {BSM_PENDING_CHECKS.map((item) => (
            <li>
              <strong>{item.label}</strong>
              <p>{item.status}</p>
              <p class="bsm-muted">계산 처리: {item.uiImpact}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="bsm-section">
        <div class="bsm-section__head">
          <p class="bsm-section__eyebrow">신청 체크리스트</p>
          <h2>계산 결과와 함께 신청 경로를 확인하세요</h2>
        </div>
        <div id="bsm-checklist" class="bsm-checklist"></div>
      </section>

      <section class="bsm-section">
        <div class="bsm-section__head">
          <p class="bsm-section__eyebrow">공식 확인 링크</p>
          <h2>최종 신청 전에는 최신 기준을 다시 확인합니다</h2>
        </div>
        <div class="bsm-reference-grid">
          {BSM_REFERENCE_LINKS.map((item) => (
            <a class="bsm-reference-card" href={item.href} target="_blank" rel="noopener noreferrer">
              <span>{item.source}</span>
              <strong>{item.title}</strong>
              <p>{item.desc}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>

    <Fragment slot="seo">
      <SeoContent
        introTitle="2027 출산지원금 계산 결과를 읽는 방법"
        intro={BSM_INTRO}
        inputPoints={BSM_INPUT_POINTS}
        criteria={BSM_CRITERIA}
        faq={BSM_FAQ}
        related={BSM_RELATED_LINKS}
      />
    </Fragment>
  </TimelineToolShell>

  <script id="birthSupportMoneyConfig" type="application/json" set:html={JSON.stringify(config)}></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <script type="module" src={withBase("/scripts/birth-support-money.js")}></script>
</BaseLayout>
