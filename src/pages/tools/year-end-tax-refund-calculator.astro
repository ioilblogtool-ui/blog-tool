---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import CalculatorHero from '../../components/CalculatorHero.astro';
import InfoNotice from '../../components/InfoNotice.astro';
import SeoContent from '../../components/SeoContent.astro';
import ToolActionBar from '../../components/ToolActionBar.astro';
import SimpleToolShell from '../../components/SimpleToolShell.astro';
import YearEndTaxField from '../../components/YearEndTaxField.astro';
import { YETC_META, YETC_DEFAULTS, YETC_FIELDS, YETC_RULES, YETC_PRESETS, YETC_FAQ, YETC_INTRO, YETC_RELATED_LINKS, YETC_SOURCES } from '../../data/yearEndTaxRefundCalculator';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => base + path;
const tabs = [{ id: 'basic', label: '1. 기본' }, { id: 'spend', label: '2. 올해 쓴 돈' }, { id: 'saving', label: '3. 절세 가능한 항목' }];
const config = { defaults: YETC_DEFAULTS, fields: YETC_FIELDS, rules: YETC_RULES, presets: YETC_PRESETS };
const faqSchema = { '@type': 'FAQPage', mainEntity: YETC_FAQ.map(item => ({
  '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer },
})) };
---
<BaseLayout title={YETC_META.seoTitle} description={YETC_META.seoDescription}
  ogImage="/og/tools/year-end-tax-refund-calculator.png" recordSessions={false} loadAds={false}
  jsonLd={{ '@context': 'https://schema.org', '@graph': [
    { '@type': 'WebApplication', name: YETC_META.title, applicationCategory: 'FinanceApplication',
      operatingSystem: 'All', inLanguage: 'ko-KR', description: YETC_META.seoDescription,
      url: 'https://bigyocalc.com/tools/year-end-tax-refund-calculator/' },
    faqSchema,
  ] }}>
  <meta slot="before-tracking" name="referrer" content="no-referrer" />
  <SiteHeader />
  <SimpleToolShell calculatorId="year-end-tax-refund-calculator" pageClass="op-page yetc-page" resultFirst={false}>
    <Fragment slot="hero">
      <CalculatorHero eyebrow="2026년 귀속 · 2027년 정산" title={YETC_META.title}
        description="예상 세금과 카드 25% 문턱을 확인하고, 연금저축·IRP를 더 넣었을 때의 절세효과를 비교하세요." />
      <p class="yetc-data-date"><span class="yetc-badge">시뮬레이션</span> 법령·안내 확인일 {YETC_META.updatedAt}</p>
      <InfoNotice title="계산 전 확인" lines={[
        YETC_META.dataNote,
        '총급여·지출·납입액은 연간 예상 합계입니다. 현재 누적액만 넣었다면 남은 기간을 자동 추정하지 않습니다.',
        '기납부 소득세를 모르면 비워두세요. 환급액을 임의로 추정하지 않으며 지방소득세는 합산하지 않습니다.',
      ]} />
      <noscript><p class="notice-box">계산 결과를 보려면 브라우저에서 자바스크립트를 허용하세요.</p></noscript>
    </Fragment>
    <Fragment slot="actions">
      <ToolActionBar resetId="yetcResetBtn" copyId="yetcCopyBtn" />
      <p class="yetc-helper">입력값은 브라우저에서 계산합니다. 공유 링크에는 소득·지출 정보가 포함되며 주소 기록에도 남을 수 있으므로 공유 대상을 확인하세요.</p>
      <p id="yetcCopyStatus" role="status"></p>
      <input id="yetcCopyFallback" class="yetc-copy-fallback" readonly hidden aria-label="직접 복사할 공유 링크" />
    </Fragment>
    <Fragment slot="aside">
      <article class="panel yetc-input-panel" data-clarity-mask="true">
        <h2 class="panel__title">내 상황 입력하기</h2>
        <div class="yetc-presets" aria-label="가상의 대표 예시">
          {YETC_PRESETS.map(preset => <button type="button" class="yetc-preset" data-yetc-preset={preset.id}
            aria-pressed="false" title={preset.summary}>{preset.label}</button>)}
        </div>
        <p class="yetc-helper">예시는 가상의 조건입니다. 선택하면 모든 입력이 해당 예시로 바뀝니다.</p>
        <div class="yetc-tab-nav" role="tablist" aria-label="연말정산 입력 단계">
          {tabs.map((tab, i) => <button type="button" role="tab" id={'yetc-tab-' + tab.id}
            data-yetc-tab={tab.id} aria-controls={'yetc-panel-' + tab.id} aria-selected={i === 0} tabindex={i === 0 ? 0 : -1}>{tab.label}</button>)}
        </div>
        {tabs.map(tab => {
          const fields = YETC_FIELDS.filter(field => field.tab === tab.id);
          const details = [...new Set(fields.map(field => field.detail).filter(Boolean))];
          return <section role="tabpanel" id={'yetc-panel-' + tab.id} data-yetc-panel={tab.id}
            aria-labelledby={'yetc-tab-' + tab.id} hidden={tab.id !== 'basic'}>
            <h3 class="yetc-panel-heading">{tab.label}</h3>
            {tab.id === 'spend' && <p class="yetc-helper">국내 공제대상 사용액만 입력하고, 특별 사용처 금액을 일반 카드 금액에 중복 입력하지 마세요. 근로제공기간 등 공제요건도 확인하세요.</p>}
            {fields.filter(field => !field.detail).map(field => <YearEndTaxField field={field} value={YETC_DEFAULTS[field.key]} />)}
            {tab.id === 'saving' && <details class="yetc-details">
              <summary>월세 공제요건 확인 목록</summary>
              <ul>
                <li>총급여 8천만원 이하, 종합소득금액 7천만원 초과 제외</li>
                <li>무주택 세대주 또는 세대주가 주택 관련 공제를 받지 않는 세대원</li>
                <li>본인 또는 기본공제 대상자 명의 임대차계약</li>
                <li>국민주택규모 또는 기준시가 4억원 이하 주택</li>
                <li>계약서 주소와 주민등록 주소 일치, 지급증빙 보관</li>
              </ul>
            </details>}
            {details.map(detail => <details class="yetc-details"><summary>{detail}</summary>
              {fields.filter(field => field.detail === detail).map(field => <YearEndTaxField field={field} value={YETC_DEFAULTS[field.key]} />)}
            </details>)}
          </section>;
        })}
      </article>
    </Fragment>
    <div id="yetcInvalid" class="notice-box" role="status" hidden>입력 오류를 확인해 주세요. 오류가 있는 동안 계산 결과는 표시하지 않고 공유 링크는 갱신하지 않습니다.</div>
    <div id="yetcResults" class="yetc-results" data-clarity-mask="true" hidden>
      <div class="yetc-kpi-grid" aria-live="polite" aria-atomic="true">
        <article id="yetcMainCard" class="yetc-kpi yetc-kpi--main">
          <span class="yetc-badge">시뮬레이션 · 소득세</span><h2 id="yetcMainLabel">예상 결정세액</h2>
          <strong id="yetcMainValue">—</strong><p id="yetcMainNote"></p>
          <button type="button" id="yetcWithheldLink" class="yetc-text-button">기납부 소득세 입력하기</button>
        </article>
        <article class="yetc-kpi"><span class="yetc-badge">시뮬레이션</span><h2>카드 공제 시작까지</h2><strong id="yetcCardValue">—</strong><p id="yetcCardNote"></p></article>
        <article class="yetc-kpi"><span class="yetc-badge">시뮬레이션</span><h2>연금 추가 공제대상 납입 여력</h2><strong id="yetcPensionValue">—</strong><p id="yetcPensionNote"></p></article>
        <article class="yetc-kpi"><span class="yetc-badge">시뮬레이션</span><h2>100만원 추가 시 가장 큰 소득세 감소</h2><strong id="yetcBestValue">—</strong><p id="yetcBestNote"></p></article>
      </div>
      <ul id="yetcWarnings" class="yetc-warnings" hidden></ul>
      <article class="panel">
        <div class="yetc-section-heading"><h2 class="panel__title">카드, 앞으로 어떻게 쓸까?</h2><span class="yetc-badge">시뮬레이션</span></div>
        <label for="yetcCardProgress">카드 공제 문턱</label>
        <progress id="yetcCardProgress" max="1" value="0" aria-describedby="yetcCardProgressText"></progress>
        <p id="yetcCardProgressText" class="yetc-progress-text"></p><p id="yetcCardCap" class="yetc-helper"></p>
        <YearEndTaxField field={YETC_FIELDS.find(f => f.key === 'additionalSpend')!} value={YETC_DEFAULTS.additionalSpend} />
        <div class="yetc-table-wrap">
          <table class="yetc-table"><caption>동일한 추가 지출의 결제수단별 비교</caption><thead><tr><th scope="col">결제수단</th><th scope="col">추가 소득공제</th><th scope="col">예상 소득세 감소</th></tr></thead><tbody id="yetcCardComparison"></tbody></table>
        </div>
        <p class="yetc-helper">두 행은 각각 독립된 가정입니다. 원래 계획한 지출의 결제수단을 비교하세요. 불필요한 소비는 줄어드는 세금보다 지출액이 큽니다.</p>
      </article>
      <article class="panel">
        <div class="yetc-section-heading"><h2 class="panel__title">연금저축·IRP를 더 넣으면?</h2><span class="yetc-badge">시뮬레이션</span></div>
        <label for="yetcPensionProgress">연금계좌 합산 공제대상 납입액</label>
        <progress id="yetcPensionProgress" max={YETC_RULES.pension.combinedCap} value="0" aria-describedby="yetcPensionProgressText"></progress>
        <p id="yetcPensionProgressText" class="yetc-progress-text"></p>
        {YETC_FIELDS.filter(f => f.key === 'additionalPension' || f.key === 'pensionTarget').map(field => <YearEndTaxField field={field} value={YETC_DEFAULTS[field.key]} />)}
        <div class="yetc-quick-buttons" aria-label="추가 납입 금액 빠른 입력">
          {[50, 100, 200, 300].map(amount => <button type="button" data-yetc-quick={amount * 10000}>{amount}만원</button>)}
        </div>
        <div class="yetc-scenario-grid">
          <div><span>명목 소득세 세액공제 증가</span><strong id="yetcPensionNominal">—</strong></div>
          <div><span>실제 예상 소득세 감소</span><strong id="yetcPensionGain">—</strong></div>
        </div>
        <div class="yetc-table-wrap"><table class="yetc-table"><caption>선택한 계좌의 추가 납입별 비교</caption><thead><tr><th scope="col">추가 납입</th><th scope="col">세액공제 증가</th><th scope="col">소득세 감소</th></tr></thead><tbody id="yetcPensionComparison"></tbody></table></div>
        <p class="yetc-helper">각 행은 독립 시나리오입니다. 세금이 이미 0이면 공제 증가가 있어도 추가 세금 감소는 없을 수 있습니다. IRP의 중도인출 제한 등 자금 사용 조건도 확인하세요.</p>
        <p><a href={withBase('/reports/pension-irp-comparison-2026/')}>연금저축과 IRP, 어디에 넣을지 비교하기</a></p>
        <p><a href={withBase('/tools/irp-pension-calculator/')}>IRP 추가 납입 후 은퇴 연금 계산하기</a></p>
      </article>
      <article class="panel">
        <h2 class="panel__title">세금이 계산되는 흐름</h2><p id="yetcMethod" class="yetc-helper"></p>
        <div class="yetc-table-wrap"><table class="yetc-table"><caption>현재 입력에 따른 소득세 계산 · 시뮬레이션</caption><thead><tr><th scope="col">단계</th><th scope="col">금액</th></tr></thead><tbody id="yetcFlow"></tbody></table></div>
        <p class="yetc-helper">환급액은 이미 낸 소득세와 결정세액의 차이입니다. 환급액이 많다고 같은 금액만큼 절세한 것은 아닙니다. 원 미만 계산 차이와 실제 징수 단위에 따라 최종 신고 금액이 달라질 수 있습니다.</p>
        <details class="yetc-details"><summary>적용 공제별 상세 보기</summary>
          <div class="yetc-table-wrap"><table class="yetc-table"><caption>선택된 공제 방식의 항목별 금액</caption><thead><tr><th scope="col">항목</th><th scope="col">소득공제액</th><th scope="col">명목 세액공제액</th></tr></thead><tbody id="yetcDeductionRows"></tbody></table></div>
          <p class="yetc-helper">소득공제는 과세표준을 낮추고 세액공제는 세금에서 차감합니다. 공제액 합계가 실제 절세액과 같지는 않습니다.</p>
        </details>
        <p><a href={withBase('/reports/2026-year-end-tax-saving-guide/')}>2026 연말정산 공제항목별 절세 전략 보기</a></p>
      </article>
    </div>
    <Fragment slot="seo">
      <article class="panel yetc-source-panel"><h2 class="panel__title">공식 계산 기준과 반영 범위</h2>
        <p><span class="yetc-badge yetc-badge--official">공식</span> 2026년 귀속 · {YETC_META.updatedAt} 법령·국세청 안내 확인</p>
        <ul>{YETC_SOURCES.map(source => <li><a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a></li>)}</ul>
        <p>다른 소득, 세액감면, 출산·입양, ISA 전환 추가한도, 의료비 특례·장애인 전용 보험료, 기부금 이월·특례, 주택담보대출 이자 등은 자동 반영하지 않습니다. 교육비는 대상자별 요건·한도를 적용한 금액, 기부금은 산정 완료한 일반 기부금 소득세 공제액을 입력하세요. 초등 저학년 예체능 교육비도 2026년 적용 대상·연령을 확인한 금액만 포함하세요.</p>
      </article>
      <SeoContent introTitle="연말정산 환급액과 남은 절세 여력 이해하기" intro={YETC_INTRO} faq={YETC_FAQ}
        related={YETC_RELATED_LINKS} inputPoints={['카드 25% 문턱과 추가 소비의 소득공제·세금 감소 구분', '연금저축·IRP의 잔여한도와 실제 세금 감소 확인', '기납부 소득세와 예상 결정세액 비교']} />
    </Fragment>
  </SimpleToolShell>
  <script is:inline id="yetcConfig" type="application/json" set:html={JSON.stringify(config).replace(/</g, '\\u003c')}></script>
  <script is:inline type="module" src={withBase('/scripts/year-end-tax-refund-calculator.js')}></script>
</BaseLayout>
